Cell[CellGroupData[{

Cell["Create a shape.", "MathCaption",
 CellID->22920951, ExpressionUUID->"d73ac0d2-2361-4f06-bfde-2ddcc0df9aba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"shape", "=", 
  RowBox[{"OpenCascadeShape", "[", 
   RowBox[{"Cone", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", "1"}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[826]:=",
 CellID->1216761116, ExpressionUUID->"3e8f44a2-3a23-42df-a099-e7b74cb30021"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8714", "]"}]], "Output",
 CellLabel->"Out[826]=",
 CellID->1139417277, ExpressionUUID->"c0959358-d00f-4c5d-8ae7-e4b260536e4e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Export the shape as a STEP file.", "MathCaption",
 CellID->529946652, ExpressionUUID->"5b781b86-c340-4a14-904f-66e2deb05a2a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fileName", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"$TemporaryDirectory", ",", "\"\<test.stp\>\""}], "}"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"OpenCascadeShapeExport", "[", 
  RowBox[{"fileName", ",", "shape"}], "]"}]}], "Input",
 CellLabel->"In[827]:=",
 CellID->623045902, ExpressionUUID->"1d9a2896-c528-44f1-b48a-0bea836d69bb"],

Cell[BoxData["\<\"/tmp/test.stp\"\>"], "Output",
 CellLabel->"Out[828]=",
 CellID->2071662749, ExpressionUUID->"1e97d4a8-a506-41ba-bc3d-365056e9ef12"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

