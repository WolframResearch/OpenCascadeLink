Cell[CellGroupData[{

Cell["Generate a shape.", "MathCaption",
 CellID->1366700854, ExpressionUUID->"5c90977d-fe74-464d-a8fb-66930f225eb6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"b1", "=", 
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"8", ",", "4", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b2", "=", 
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b3", "=", 
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"4", ",", 
       RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "2", ",", "2"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"shapes", "=", 
   RowBox[{"OpenCascadeShape", "/@", 
    RowBox[{"{", 
     RowBox[{"b1", ",", "b2", ",", "b3"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"shape", "=", 
  RowBox[{"OpenCascadeShapeUnion", "@@", "shapes"}]}]}], "Input",
 CellLabel->"In[797]:=",
 CellID->734947802, ExpressionUUID->"d93d57f4-7a34-419c-8ad9-4015d52d072e"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8709", "]"}]], "Output",
 CellLabel->"Out[800]=",
 CellID->1105006182, ExpressionUUID->"760b84ee-898b-4f18-aabb-641c73130725"]
}, Open  ]]
