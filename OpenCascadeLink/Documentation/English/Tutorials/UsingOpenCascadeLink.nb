Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"ImplicitRegion", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "4"}], " ", 
        SuperscriptBox["y", "2"]}], "-", 
       RowBox[{"4", " ", "x", " ", 
        SuperscriptBox["y", "2"]}], "+", 
       SuperscriptBox["y", "4"], "+", 
       RowBox[{"4", " ", "x", " ", 
        SuperscriptBox["z", "2"]}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["x", "2"], " ", 
        SuperscriptBox["z", "2"]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["y", "2"], " ", 
        SuperscriptBox["z", "2"]}], "+", 
       SuperscriptBox["z", "4"]}], "\[Equal]", "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"ToBoundaryMesh", "[", 
    RowBox[{"r", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"bmesh", "[", "\"\<Wireframe\>\"", "]"}]}], "Input",
 CellLabel->"In[143]:=",
