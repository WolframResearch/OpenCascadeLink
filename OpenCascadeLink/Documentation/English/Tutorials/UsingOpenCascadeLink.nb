Cell["\<\
Back to the half disk object. This Object can be projected to any other \
position by using a transformation function. This works the same way as with \
other OpenCascade shapes.\
\>", "Text",
 CellID->151973800, ExpressionUUID->"8d0ae700-38ef-4d2a-808f-980ccf1d6ef6"],

Cell[CellGroupData[{

Cell["Create a transformation function.", "MathCaption",
 CellID->1786857665, ExpressionUUID->"3eda3c07-466d-4f34-9cc4-ab41b9783ba0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tf", "=", 
  RowBox[{"RotationTransform", "[", 
   RowBox[{
    RowBox[{"\[Pi]", "/", "2"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[9]:=",
 CellID->1522939246, ExpressionUUID->"439d12ba-0b05-4a24-bd68-b61c9e1dd9c6"],

Cell[BoxData[
 RowBox[{"TransformationFunction", "[", 
  RowBox[{"(", 
   TagBox[GridBox[{
      {"1", "0", "0", "0"},
      {"0", "0", 
       RowBox[{"-", "1"}], "0"},
      {"0", "1", "0", "0"},
      {"0", "0", "0", "1"}
     },
     AutoDelete->False,
     GridBoxDividers->{
      "Columns" -> {{False}}, "ColumnsIndexed" -> {-2 -> True}, 
       "Rows" -> {{False}}, "RowsIndexed" -> {-2 -> True}},
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
    #& ], ")"}], "]"}]], "Output",
 CellLabel->"Out[9]=",
 CellID->68364297, ExpressionUUID->"31498c8b-be11-4d29-a3d7-6308595d4644"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Apply the transformation function to the ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " shape."
}], "MathCaption",
 CellID->863440484, ExpressionUUID->"abc534e9-360a-4f9e-8c1e-2fd0041111d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"i2", "=", 
  RowBox[{"OpenCascadeShapeTransformation", "[", 
   RowBox[{"i", ",", "tf"}], "]"}]}]], "Input",
 CellLabel->"In[10]:=",
 CellID->2098362344, ExpressionUUID->"67f4f967-9a9b-4d6a-b060-e6ad241b67ae"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "5", "]"}]], "Output",
 CellLabel->"Out[10]=",
 CellID->528497987, ExpressionUUID->"645e63d6-0c54-4112-bb34-ab9a6b6d08f9"]
}, Open  ]]
}, Open  ]],

