  ButtonBox["FilledCurve",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "395d42c2-4439-483a-9fb9-70a6b8303987"],
 "."
}], "MathCaption",
 CellID->1643788727, ExpressionUUID->"b972e3b1-1c4d-43b7-a2f3-d057294f192d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fc", "=", 
