Cell[TextData[{
 "To create a 2D boundary mesh the function ",
 Cell[BoxData[
 "ElementMeshProjection"], "InlineFormula", ExpressionUUID->
  "be8486e2-39cd-48a1-bda5-14f023a5452f"],
 " can be used."
}], "Text",
 CellID->1577106694, ExpressionUUID->"e7f0a720-bf87-4fee-9185-c550675741bb"],

Cell[CellGroupData[{

Cell["\<\
Create a half disk, generate a boundary mesh and project the mesh to 2D.\
\>", "MathCaption",
 CellID->1275730947, ExpressionUUID->"fe9f4e72-da54-418a-aa8f-f84e8fca6fac"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"i", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Disk", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "i", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ElementMeshProjection", "[", 
   RowBox[{"bmesh", ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}]}], "]"}], 
  "[", "\"\<Wireframe\>\"", "]"}]}], "Input",
 CellLabel->"In[12]:=",
 CellID->1412841872, ExpressionUUID->"c26d8eef-c7fc-485d-9260-3f6df0ac63de"],

Cell[BoxData[
 GraphicsBox[
  {RGBColor[
   0.00010000076130382223`, 0.00010000076130382223`, 0.00010000076130382223`],
    EdgeForm[RGBColor[
   0.00010000076130382223`, 0.00010000076130382223`, 
    0.00010000076130382223`]], FaceForm[None], 
   GraphicsComplexBox[{{0., 0.}, {1., 0.}, {0.9807852804032304, 
