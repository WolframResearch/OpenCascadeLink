Cell[CellGroupData[{

Cell["Torus", "Subsubsection",
 CellID->2066495706, ExpressionUUID->"daf430d0-a4fe-4d23-87f5-e5c8ed5c7131"],

Cell["\<\
Here the arguments are an axis around which the torus is located, a radius \
from the axis to the interior of the  torus and a second radius specifying \
the the radius of the interior of the torus.\
\>", "Text",
