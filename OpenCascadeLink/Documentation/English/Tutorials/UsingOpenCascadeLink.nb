Cell[CellGroupData[{

Cell["Chamfers", "Subsection",
 CellID->1452705609, ExpressionUUID->"c5021b81-8f64-4238-a152-5844f59fb27c"],

Cell["\<\
Chamfers are similar to fillets. The difference is that chamfers are not \
rounded but planes. The chamfers created are symmetric and the function's \
parameter specifies the distance tangential to which the chamfer surface will \
be created.\
\>", "Text",
 CellID->69596028, ExpressionUUID->"4e081f09-1e0a-4648-8a44-a6462781e6fa"],

Cell[CellGroupData[{

Cell["Generate a shape.", "MathCaption",
 CellID->277088159, ExpressionUUID->"d89c097d-04b1-43c2-8122-e63bf60d20a7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"shape", "=", 
  RowBox[{"OpenCascadeShape", "[", 
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[737]:=",
 CellID->2096153626, ExpressionUUID->"ab71b58d-0d38-4c75-9cb2-03551f7c76ae"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8618", "]"}]], "Output",
 CellLabel->"Out[737]=",
 CellID->413713041, ExpressionUUID->"87abd92b-0c41-42a9-a506-a7da7cb6bf9d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Look at the ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " shape type."
}], "MathCaption",
 CellID->629330765, ExpressionUUID->"ebf0ebe8-78d0-4cc8-a517-8b80c233152c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OpenCascadeShapeType", "[", "shape", "]"}]], "Input",
 CellLabel->"In[738]:=",
 CellID->574616883, ExpressionUUID->"87b89184-c9f6-4831-a4a9-b47b63eb16d5"],

Cell[BoxData["\<\"Solid\"\>"], "Output",
 CellLabel->"Out[738]=",
 CellID->1345548709, ExpressionUUID->"338caae2-5ec0-4f1a-b88e-be3a14a4f714"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Apply chamfer to edges 5 and 6.", "MathCaption",
 CellID->1212826035, ExpressionUUID->"adec45e8-502e-4faf-9838-f538de86298a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"chamfer", "=", 
  RowBox[{"OpenCascadeShapeChamfer", "[", 
   RowBox[{"shape", ",", "0.25", ",", 
    RowBox[{"{", 
     RowBox[{"5", ",", "6"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[739]:=",
 CellID->1658932706, ExpressionUUID->"f7ab4ae5-ceb3-4831-85ec-36a15286a5b5"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8619", "]"}]], "Output",
 CellLabel->"Out[739]=",
 CellID->498831397, ExpressionUUID->"4a898e6c-b420-4442-a472-d287255a00b6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Look at the ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " shape type."
}], "MathCaption",
 CellID->1271579252, ExpressionUUID->"04531b2e-852e-4111-8636-e73703aa9aff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OpenCascadeShapeType", "[", "chamfer", "]"}]], "Input",
