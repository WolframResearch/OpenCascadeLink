Cell[CellGroupData[{

Cell[TextData[{
 "Create a ",
 Cell[BoxData[
  ButtonBox["Ball",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "5f7c3eb2-8197-4ae4-ae3b-974dff91b9a3"],
 " and a ",
 Cell[BoxData[
  ButtonBox["Pyramid",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "dd6705be-4234-468a-88f7-9be3344ed4ce"],
 " shape."
}], "MathCaption",
 CellID->1487618738, ExpressionUUID->"7cd0bd98-1e37-4827-b62a-cc6286ec7027"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"shape1", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Ball", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shape2", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Pyramid", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "2"}], "}"}]}], "}"}], "-", "1"}], "]"}],
     "]"}]}], ";"}]}], "Input",
 CellLabel->"In[468]:=",
 CellID->693047746, ExpressionUUID->"37de8f69-b4c4-48a9-abda-dd038cd0fe00"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute the geometric union of the shapes", "MathCaption",
 CellID->659470758, ExpressionUUID->"d7c11779-3c57-46f1-811c-28e27a80493c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"union", "=", 
  RowBox[{"OpenCascadeShapeUnion", "[", 
   RowBox[{"shape1", ",", "shape2"}], "]"}]}]], "Input",
 CellLabel->"In[470]:=",
 CellID->420319460, ExpressionUUID->"2e4ebc3f-617a-4de9-98f5-2e52cafba29f"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8438", "]"}]], "Output",
 CellLabel->"Out[470]=",
 CellID->406157631, ExpressionUUID->"d096bca5-a1e2-4695-b24d-86166504a390"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Extract the boundary mesh.", "MathCaption",
 CellID->740038792, ExpressionUUID->"46194ddc-c330-4465-b58f-3e6f1197e363"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "union", "]"}]}],
   ";"}]], "Input",
 CellLabel->"In[471]:=",
 CellID->1729070065, ExpressionUUID->"b39257b8-710e-41d8-9b45-757f68b14d73"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Look at the boundary element marker union and create colors for the markers.\
\>", "MathCaption",
 CellID->711595451, ExpressionUUID->"4e7cb893-92aa-49ef-a280-61c11646f1b3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"bmesh", "[", "\"\<BoundaryElementMarkerUnion\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temp", "=", 
   RowBox[{"Most", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "1", ",", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"Length", "[", "groups", "]"}], ")"}]}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"colors", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<BrightBands\>\"", "]"}], "[", "#", "]"}], 
    "&"}], "/@", "temp"}]}]}], "Input",
 CellLabel->"In[472]:=",
 CellID->1758067164, ExpressionUUID->"37aab2b1-68f5-463f-a50f-af1fe4cfcf1c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[<|"color" -> RGBColor[0.90222, 0.101808, 0.198306]|>,
    "RGBColorSwatchTemplate"], ",", 
   TemplateBox[<|
    "color" -> RGBColor[
      0.43315467307722716`, 0.3384619423049553, 0.9999676857362557]|>,
    "RGBColorSwatchTemplate"], ",", 
