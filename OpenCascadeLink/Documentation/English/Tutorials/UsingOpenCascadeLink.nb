Cell[CellGroupData[{

Cell[TextData[{
 "Construct the surfaces in ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 "."
}], "MathCaption",
 CellID->773348629, ExpressionUUID->"42a509b8-7eae-4467-8954-78a34e298aa5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"surface", "=", 
   RowBox[{"OpenCascadeShape", "[", "bss", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Polygon", "[", "top", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Polygon", "[", "bottom", "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[634]:=",
 CellID->2058102829, ExpressionUUID->"ccc27b16-865f-41a0-9ed1-289a2601e8f0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sew the surfaces together.", "MathCaption",
 CellID->428502501, ExpressionUUID->"59fb6f37-894a-4d54-8235-5268e58fef1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"shape", "=", 
  RowBox[{"OpenCascadeShapeSewing", "[", 
   RowBox[{"{", 
    RowBox[{"surface", ",", "p1", ",", "p2"}], "}"}], "]"}]}]], "Input",
 CellLabel->"In[637]:=",
 CellID->1323873978, ExpressionUUID->"0c946f3a-60fc-45c9-b9b0-f2f51741eb64"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8550", "]"}]], "Output",
 CellLabel->"Out[637]=",
 CellID->1458185670, ExpressionUUID->"58d1e57d-26aa-475b-b7f8-92dbc36bce97"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Look at the ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " shape type."
}], "MathCaption",
 CellID->1297340170, ExpressionUUID->"54444b27-75a5-4145-b767-1f5e93addea4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OpenCascadeShapeType", "[", "shape", "]"}]], "Input",
 CellLabel->"In[638]:=",
 CellID->297178969, ExpressionUUID->"289fdc4f-667c-4063-ab92-f91ff9a4925e"],

Cell[BoxData["\<\"Shell\"\>"], "Output",
 CellLabel->"Out[638]=",
 CellID->1012948855, ExpressionUUID->"d85d5bfa-c0eb-4df0-981d-90c31f5a3e06"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Convert to a solid.", "MathCaption",
 CellID->977379690, ExpressionUUID->"65567321-9bf9-4817-bb87-96644121bb3d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"shape", "=", 
   RowBox[{"OpenCascadeShapeSolid", "[", "shape", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"OpenCascadeShapeType", "[", "shape", "]"}]}], "Input",
 CellLabel->"In[639]:=",
 CellID->503546497, ExpressionUUID->"10dce1a5-a2ae-4e7c-b5c3-12c182ffb1a9"],

Cell[BoxData["\<\"Solid\"\>"], "Output",
 CellLabel->"Out[640]=",
 CellID->375986866, ExpressionUUID->"d953a855-cd0d-49bf-99cb-073b228ab11d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Extract and visualize the boundary mesh.", "MathCaption",
 CellID->1977243028, ExpressionUUID->"e5a318a0-f88f-4303-9765-249d866f0dfd"],

Cell[CellGroupData[{

