Cell[CellGroupData[{

Cell["Boolean operations on solids", "Subsubsection",
 CellTags->"BooleanOperationsOnSolids",
 CellID->1756733038, ExpressionUUID->"fb3a47e9-90ab-4c68-a65b-8778789e3281"],

Cell[TextData[{
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " handles Boolean operations in a slightly different manner than the Wolfram \
Language Boolean operators ",
 Cell[BoxData[
  ButtonBox["RegionUnion",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "1acf3cee-ca01-4665-b7ca-b6bc9aed0291"],
 ", ",
 Cell[BoxData[
  ButtonBox["RegionIntersection",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "3866da99-2460-4e69-9c7b-d363dc3e9ec3"],
 " and ",
 Cell[BoxData[
  ButtonBox["RegionDifference",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "2a70e86f-cf76-4650-9616-d3bdb3e6ad86"],
 ". It's illustrative to walk through several examples."
}], "Text",
 CellID->1288037467, ExpressionUUID->"c025525c-a17f-4406-b653-069a773d7dd3"],

Cell[CellGroupData[{

Cell["Solids overlapping", "Subsubsubsection",
 CellID->1138520460, ExpressionUUID->"e35f223a-c7b3-4150-a529-6de121d8c5ec"],

Cell[CellGroupData[{

Cell["Create two overlapping cubes.", "MathCaption",
 CellID->786782962, ExpressionUUID->"0e637310-d7a6-4e97-b2ba-474ddb133878"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gr1", "=", 
  RowBox[{"Graphics3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Opacity", "[", "0.5", "]"}], ",", 
       RowBox[{"c1", "=", 
        RowBox[{"Cuboid", "[", "]"}]}], ",", 
       RowBox[{"c2", "=", 
        RowBox[{"Cuboid", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "4"}], ",", 
           RowBox[{"1", "/", "4"}], ",", 
           RowBox[{"1", "/", "4"}]}], "}"}], "]"}]}]}], "}"}], "}"}], ",", 
    RowBox[{"Boxed", "\[Rule]", "False"}]}], "]"}]}]], "Input",
 CellLabel->"In[551]:=",
 CellID->255742765, ExpressionUUID->"85babe3c-24c9-4f01-903f-3e0d28320f38"],

Cell[BoxData[
 Graphics3DBox[
  {Opacity[0.5], CuboidBox[{0, 0, 0}], 
   CuboidBox[
    NCache[{Rational[1, 4], Rational[1, 4], Rational[1, 4]}, {0.25, 0.25, 
     0.25}]]},
  Boxed->False,
  ImageSize->{290.84857012554545`, 308.4552031880882},
  ImageSizeRaw->Automatic,
  ViewPoint->{2.2392238883670967`, -1.54621686541277, 2.011240856506065},
  ViewVertical->{-0.012247911366912556`, 0.044923915170860584`, 
   0.9989153269986749}]], "Output",
 CellLabel->"Out[551]=",
 CellID->532714173, ExpressionUUID->"bdd88856-08f5-48ea-89ff-58c4d2880921"]
}, Open  ]]
}, Open  ]],

