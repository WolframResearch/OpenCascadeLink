Cell[TextData[{
 "Step assemblies are imported as ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " Compounds. The function ",
 Cell[BoxData[
 "OpenCascadeShapeNumberOfSolids"], "InlineFormula", ExpressionUUID->
  "652ae0d1-597e-4fb4-905a-72029a225a56"],
 " can be used to find the number of solids parts in the assembly and the \
function ",
 Cell[BoxData[
 "OpenCascadeShapeSolids"], "InlineFormula", ExpressionUUID->
  "fecf3314-d93c-434c-b69d-a171b3f6db32"],
 " can extract the parts."
}], "Text",
 CellID->4866229, ExpressionUUID->"930d6d2a-0855-45aa-a000-e657d076f3fb"]
