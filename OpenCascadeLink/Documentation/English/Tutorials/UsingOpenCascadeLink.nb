Cell[CellGroupData[{

Cell["Internal boundaries", "Subsection",
 CellID->954199870, ExpressionUUID->"a0799d20-2071-4839-9ba9-fd61473a1d3d"],

Cell[TextData[{
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " offers several ways to include internal boundaries for creating geometric \
models with multiple materials."
}], "Text",
 CellID->296868768, ExpressionUUID->"6b12b5f5-7516-4143-b67a-747a71518d57"],

Cell[CellGroupData[{

Cell["Internal boundaries by union of faces", "Subsubsection",
 CellID->1472338573, ExpressionUUID->"3210ef52-841b-4f39-85b9-87031562887f"],

Cell["\<\
Forming the union of solids will leave the position of the over lap open.\
\>", "Text",
 CellID->417902245, ExpressionUUID->"6c482320-a057-48f6-91b7-8af4ba774c27"],

Cell[CellGroupData[{

Cell["Create two touching cubes that touch at an edge.", "MathCaption",
 CellID->1630994282, ExpressionUUID->"8b175aea-926a-4783-8aaf-0969737a5c11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Graphics3D", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Opacity", "[", "0.5", "]"}], ",", 
      RowBox[{"c1", "=", 
       RowBox[{"Cuboid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.5", ",", "1", ",", "1"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"c2", "=", 
       RowBox[{"Cuboid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.5", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "2"}], "}"}]}], "]"}]}]}], "}"}], "}"}],
    ",", 
   RowBox[{"Boxed", "\[Rule]", "False"}]}], "]"}]], "Input",
 CellLabel->"In[665]:=",
 CellID->1598481651, ExpressionUUID->"b13bb127-1ab0-4c07-a409-041e778614ba"],

Cell[BoxData[
 Graphics3DBox[
  {Opacity[0.5], CuboidBox[{0, 0, 0}, {0.5, 1, 1}], 
   CuboidBox[{0.5, 0, 0}, {1, 1, 2}]},
  Boxed->False]], "Output",
 CellLabel->"Out[665]=",
 CellID->443975633, ExpressionUUID->"2ecf8f25-e750-498b-a7c3-1c06014b4b58"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Create the OpenCascade shapes.", "MathCaption",
 CellID->2099271000, ExpressionUUID->"42df974f-ff30-455f-960f-aebdc2e9baa1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"shape1", "=", 
   RowBox[{"OpenCascadeShape", "[", "c1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shape2", "=", 
   RowBox[{"OpenCascadeShape", "[", "c2", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[666]:=",
 CellID->1859166226, ExpressionUUID->"fdd53add-d2a0-48d3-ae2f-e80579157ca1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Form the union and visualize the full mesh.", "MathCaption",
 CellID->802954528, ExpressionUUID->"10ebf1be-3ec0-4436-9dd0-d285b9bb448c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"union", " ", "=", " ", 
   RowBox[{"OpenCascadeShapeUnion", " ", "[", 
    RowBox[{"shape1", ",", " ", "shape2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "union", "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ToElementMesh", "[", 
   RowBox[{"bmesh", ",", 
    RowBox[{"MaxCellMeasure", "\[Rule]", "0.01"}]}], "]"}], 
  "[", "\"\<Wireframe\>\"", "]"}]}], "Input",
 CellLabel->"In[668]:=",
 CellID->1307812248, ExpressionUUID->"0bb491af-e99b-4092-8f85-34f5248b9b1f"],

