Cell["\<\
As a second step the boundary mesh can be rescaled to it's intended scale.\
\>", "Text",
 CellID->177965153, ExpressionUUID->"31779f1c-ec77-48b9-aae1-549c891b4f65"],

Cell[CellGroupData[{

Cell["Inspect the length unit of the boundary mesh.", "MathCaption",
 CellID->112202668, ExpressionUUID->"71c3240b-138b-44c4-84a2-b08ddd35bf13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bmesh", "[", "\"\<LengthUnit\>\"", "]"}]], "Input",
 CellLabel->"In[892]:=",
 CellID->44585010, ExpressionUUID->"49598fcb-e343-49e6-8f1d-ce039928b244"],

Cell[BoxData["None"], "Output",
 CellLabel->"Out[892]=",
 CellID->1083287541, ExpressionUUID->"c3ce855b-60b6-44e9-b4b0-951f81f5596b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Set a length unit.", "MathCaption",
 CellID->920251308, ExpressionUUID->"432e0445-dd2c-4411-bdae-d9979e6b2a2a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SetLengthUnit", "[", 
  RowBox[{"bmesh", ",", "\"\<Micrometers\>\""}], "]"}]], "Input",
 CellLabel->"In[893]:=",
 CellID->1415067105, ExpressionUUID->"feabd818-932e-41f9-b86f-a74e1daf7faf"],

Cell[BoxData["\<\"Micrometers\"\>"], "Output",
 CellLabel->"Out[893]=",
 CellID->88739568, ExpressionUUID->"b8a6bcdb-bcb5-4edc-8f46-3d23b392c7a7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rescale the mesh.", "MathCaption",
 CellID->412195832, ExpressionUUID->"d83e8816-faf7-46cf-8005-b7703fd05e3c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bmesh2", "=", 
  RowBox[{"ElementMeshCoordinateRescale", "[", 
   RowBox[{"bmesh", ",", "\"\<Meters\>\""}], "]"}]}]], "Input",
 CellLabel->"In[894]:=",
 CellID->1283666923, ExpressionUUID->"b66c728e-f334-4305-90b5-40ea2d242b7c"],

Cell[BoxData[
 TagBox[
  RowBox[{"ElementMesh", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.`*^-8"}], ",", "1.992708874098054`*^-8"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.`*^-8"}], ",", "1.`*^-8"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.0000000000000007`*^-8"}], ",", 
        "1.0000000000000007`*^-8"}], "}"}]}], "}"}], ",", "Automatic"}], "]"}],
  False,
  Editable->False,
  SelectWithContents->True]], "Output",
 CellLabel->"Out[894]=",
 CellID->1837499523, ExpressionUUID->"f8ef32fa-4f7f-4ff1-8d96-3098ea4bafec"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Inspect the region bounds.", "MathCaption",
 CellID->337302380, ExpressionUUID->"9ea780c3-d327-4869-9270-785a00fa2829"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bmesh2", "[", "\"\<Bounds\>\"", "]"}]], "Input",
 CellLabel->"In[895]:=",
 CellID->2017198130, ExpressionUUID->"6f94979a-931d-470b-aafc-b150f57cb19b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1.`*^-8"}], ",", "1.992708874098054`*^-8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1.`*^-8"}], ",", "1.`*^-8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1.0000000000000007`*^-8"}], ",", 
     "1.0000000000000007`*^-8"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[895]=",
 CellID->2024960260, ExpressionUUID->"cd4bf65a-5450-40cb-983a-a8c3a8eb837d"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "One thing to keep in mind though, is that a subsequent finite element \
analysis might benefit if the geometry is left in the rescale size and the \
PDE coefficients are adjusted to the new length scale. This can improve the \
stability of numerical solutions. This is outlined, for example, in the ",
 ButtonBox["solid mechanics monograph",
  BaseStyle->"Link",
  ButtonData->
   "paclet:PDEModels/tutorial/StructuralMechanics/SolidMechanics#120132876"],
 "."
}], "Text",
 CellID->2120377597, ExpressionUUID->"6972b453-1f6f-4873-9fde-c234de010681"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Utility functions", "Section",
 CellID->1259037708, ExpressionUUID->"e2936dee-6883-4b2a-887e-6cbd9dd4a6a3"],

Cell[CellGroupData[{

Cell["VisualizeEdgeFunction", "Subsubsubsubsection",
 CellID->1145909479, ExpressionUUID->"3fae42c3-619c-4382-a38e-562158bd4f76"],

Cell[TextData[{
 "The function ",
 Cell[BoxData[
 "VisualizeEdgeFunction"], "InlineFormula", ExpressionUUID->
  "5122c34f-c2df-46c5-bafb-917f8ce9f08c"],
 " can be used to scroll through the edges of a region and apply an edge \
operation."
}], "Text",
 CellID->1952099049, ExpressionUUID->"c79e74b8-02bc-468d-8da6-300414da3119"],

Cell["\<\
Should not use SaveDefinitions and needs full path specification: \
https://bugs.wolfram.com/show?number=439031\
\>", "Text", "ExcludedMaterial",
 CellID->115946767, ExpressionUUID->"489c2ba0-953b-4c8d-8ede-6f6fac3034b5"],

Cell[CellGroupData[{

Cell["\<\
A utility function to interactively visualize edge operations.\
\>", "MathCaption",
 CellID->544414131, ExpressionUUID->"05d3e05c-a6ca-46ae-9dc8-e4b05410c8ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VisualizeEdgeFunction", "[", 
   RowBox[{"region_", ",", "funIn_"}], "]"}], ":=", 
  RowBox[{"With", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fun", "=", "funIn"}], ",", 
      RowBox[{"ishape", "=", 
       RowBox[{"OpenCascadeLink`OpenCascadeShape", "[", "region", "]"}]}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"numEdges", "=", 
         RowBox[{
         "OpenCascadeLink`OpenCascadeShapeNumberOfEdges", "[", "ishape", 
          "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"bmesh", "=", 
         RowBox[{
         "OpenCascadeLink`OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", 
          "ishape", "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Manipulate", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"shape", ",", "newShape"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"shape", "=", 
            RowBox[{
            "OpenCascadeLink`OpenCascadeShape", "[", "region", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"newShape", "=", 
            RowBox[{"fun", "[", 
             RowBox[{"shape", ",", "edge"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Show", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"bmesh", "[", 
              RowBox[{"\"\<Edgeframe\>\"", "[", 
               RowBox[{"\"\<EdgeframeDirective\>\"", "->", "LightGray"}], 
               "]"}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"newShape", "===", "$Failed"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", "}"}], "\[IndentingNewLine]", ",", 
               RowBox[{
                RowBox[{
                "OpenCascadeLink`OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[",
                  "newShape", "]"}], "[", "\"\<Edgeframe\>\"", "]"}]}], 
              "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
             RowBox[{"PlotLabel", "->", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<Edge = \>\"", "<>", 
                RowBox[{"ToString", "[", "edge", "]"}]}], "]"}]}]}], 
            "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"edge", ",", "1", ",", "numEdges", ",", "1", ",", 
          RowBox[{"Appearance", "\[Rule]", "\"\<Open\>\""}]}], "}"}], ",", 
        RowBox[{"Initialization", ":>", 
         RowBox[{"(", 
          RowBox[{"Needs", "[", "\"\<OpenCascadeLink`\>\"", "]"}], ")"}]}]}], 
       "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
