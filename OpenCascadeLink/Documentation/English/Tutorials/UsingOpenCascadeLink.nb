Cell[TextData[{
 "To mirror a shape ",
 Cell[BoxData[
  ButtonBox["ReflectionTransform",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "ac8196d2-4465-4415-99b6-001e15426820"],
 " can be used."
}], "Text",
 CellID->13385795, ExpressionUUID->"65a1be62-c900-499b-bab9-badc28d06546"],

Cell[CellGroupData[{

Cell["Create a mirrored shape.", "MathCaption",
 CellID->1099948698, ExpressionUUID->"8a37331d-0ed9-4cc5-833f-639e9def6f20"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rt", "=", 
   RowBox[{"ReflectionTransform", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1.1"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"rshape", "=", 
  RowBox[{"OpenCascadeShape", "[", 
   RowBox[{"TransformedRegion", "[", 
    RowBox[{
     RowBox[{"Cone", "[", "]"}], ",", "rt"}], "]"}], "]"}]}]}], "Input",
 CellLabel->"In[330]:=",
 CellID->1726886798, ExpressionUUID->"551d23e5-b2fb-41b2-82e9-739f8aa9ddf3"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8362", "]"}]], "Output",
 CellLabel->"Out[331]=",
 CellID->252531616, ExpressionUUID->"b7aaa91f-c5d3-4a4a-ac07-70a6a9645017"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Extract and visualize the boundary ",
 Cell[BoxData[
  ButtonBox["ElementMesh",
   BaseStyle->"Link",
   ButtonData->"paclet:FEMDocumentation/ref/ElementMesh"]], "InlineFormula",
  ShowStringCharacters->False, ExpressionUUID->
  "96be66ce-014a-458d-8597-3b592e4c8949"],
 " and the shape rotated in the Wolfram language."
}], "MathCaption",
 CellID->788835334, ExpressionUUID->"d99e0e31-cdf3-410f-8412-0510e9e2370f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{
   "OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "rshape", "]"}]}], ";", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"bmesh", "[", "\"\<Wireframe\>\"", "]"}], ",", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{"Cone", "[", "]"}], "]"}], "\[IndentingNewLine]", ",", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{"GeometricTransformation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", ".85", "]"}], ",", "Red", ",", 
         RowBox[{"Cone", "[", "]"}]}], "}"}], ",", "rt"}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[332]:=",
 CellID->1446586607, ExpressionUUID->"bcb503e6-42b7-4b06-ade2-ed8c7937f39a"],

