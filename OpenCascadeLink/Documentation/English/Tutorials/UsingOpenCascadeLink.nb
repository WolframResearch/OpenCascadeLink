Cell[CellGroupData[{

Cell["Lofting", "Subsection",
 CellID->2089305334, ExpressionUUID->"51e2e3de-eeeb-4910-b997-7f55e028ebbd"],

Cell["\<\
A loft surface or solid is generated by creating surfaces that pass through \
wires. The concept is easily understood once a visualization has explained it.\
\>", "Text",
 CellID->1511985804, ExpressionUUID->"dff4bb30-e0d6-459a-a51d-eb12338b1a00"],

Cell[CellGroupData[{

