Cell[CellGroupData[{

Cell["Internal boundaries by sewing", "Subsubsection",
 CellID->1878723933, ExpressionUUID->"3798f3f4-5741-410c-b11d-7da19b0acd8a"],

Cell["\<\
Shape sewing can also be used to generate shapes that have internal \
boundaries.\
\>", "Text",
 CellID->269846281, ExpressionUUID->"659ad981-cf67-4157-be4b-758d99d94f3e"],

Cell[CellGroupData[{

Cell["Generate two shapes.", "MathCaption",
 CellID->1747400495, ExpressionUUID->"a12de689-f039-4ac1-b871-c301d14bbf3c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"shape1", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Cuboid", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", 
        RowBox[{"-", "2"}], ",", 
        RowBox[{"-", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", 
        RowBox[{"1", "/", "2"}]}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shape2", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Cylinder", "[", "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[678]:=",
 CellID->1407081144, ExpressionUUID->"14ce7d39-6ce6-450c-a70d-bc40bf93aab0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute the geometric union between the two shapes.", "MathCaption",
 CellID->1955054548, ExpressionUUID->"1601a0df-eaaf-423b-887f-9a5866d752bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"union", "=", 
  RowBox[{"OpenCascadeShapeUnion", " ", "[", 
   RowBox[{"shape1", ",", "shape2"}], "]"}]}]], "Input",
 CellLabel->"In[680]:=",
 CellID->140044653, ExpressionUUID->"846e1982-d7ea-4477-af49-f7c6853e17bd"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8591", "]"}]], "Output",
 CellLabel->"Out[680]=",
 CellID->599315225, ExpressionUUID->"d9957651-2c88-41fd-b956-03b90ba09c6b"]
}, Open  ]]
}, Open  ]],

