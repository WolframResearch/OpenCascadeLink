Cell[CellGroupData[{

Cell[TextData[{
 "Create a ",
 Cell[BoxData[
  ButtonBox["Ball",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "96523853-0b2c-40a1-b0b0-826abf5bc96b"],
 " and a ",
 Cell[BoxData[
  ButtonBox["Hexahedron",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "5f3f874d-0e74-42c6-a542-de123761c413"],
 " shape."
}], "MathCaption",
 CellID->98082994, ExpressionUUID->"87848b34-59d1-432f-95ba-6ccd3356e84e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"shape1", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Ball", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shape2", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Hexahedron", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[459]:=",
 CellID->1117066463, ExpressionUUID->"dde5f762-00e9-4b29-959b-cce5be75de12"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute the geometric union of the shapes", "MathCaption",
 CellID->1701638198, ExpressionUUID->"83314da0-f3c1-4a82-9b33-a5a3a724b1bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"union", "=", 
  RowBox[{"OpenCascadeShapeUnion", "[", 
   RowBox[{"shape1", ",", "shape2"}], "]"}]}]], "Input",
 CellLabel->"In[461]:=",
 CellID->1288026700, ExpressionUUID->"4ef0c108-ff88-4318-bd3e-b9a1d2c6eefe"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8430", "]"}]], "Output",
 CellLabel->"Out[461]=",
 CellID->1951818558, ExpressionUUID->"245d30d3-f919-4e4c-941d-338a0d2c5530"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Extract the boundary mesh.", "MathCaption",
 CellID->1470222008, ExpressionUUID->"c08c84f1-1bcc-4e73-aedf-3ad16197b47b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "union", "]"}]}],
   ";"}]], "Input",
 CellLabel->"In[462]:=",
 CellID->1856157212, ExpressionUUID->"1b6a9fc0-6553-4094-a22e-468ffa155b56"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Look at the boundary element marker union and create colors for the markers.\
\>", "MathCaption",
 CellID->207992304, ExpressionUUID->"4f392d1c-9925-4eb5-97d5-d2162131fe56"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"bmesh", "[", "\"\<BoundaryElementMarkerUnion\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temp", "=", 
   RowBox[{"Most", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "1", ",", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"Length", "[", "groups", "]"}], ")"}]}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"colors", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<BrightBands\>\"", "]"}], "[", "#", "]"}], 
    "&"}], "/@", "temp"}]}]}], "Input",
 CellLabel->"In[463]:=",
 CellID->1335253696, ExpressionUUID->"63e339af-8f82-4c43-8878-4adfc81aa1a6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
