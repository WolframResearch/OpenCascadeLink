 CellID->720525368, ExpressionUUID->"b7f4b6ca-6bfc-42d7-8afc-c0b9b78112c1"],

Cell[CellGroupData[{

Cell["Generate a boundary mesh and project the mesh to 2D.", "MathCaption",
 CellID->1832394922, ExpressionUUID->"235ca8c8-905e-4671-8135-685f4689e4d1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "face", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ElementMeshProjection", "[", 
   RowBox[{"bmesh", ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}]}], "]"}], 
  "[", "\"\<Wireframe\>\"", "]"}]}], "Input",
 CellLabel->"In[269]:=",
