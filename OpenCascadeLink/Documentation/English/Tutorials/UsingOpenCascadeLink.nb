Cell[CellGroupData[{

Cell[TextData[{
 "Convert the symbolic regions to ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " and sew them together:"
}], "MathCaption",
 CellID->1270685417, ExpressionUUID->"69d1f1c8-9b2c-41b4-967c-30168b3acb6d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cylinderShape", "=", 
   RowBox[{"OpenCascadeShape", "[", "cylinder", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cuboid1Shape", "=", 
   RowBox[{"OpenCascadeShape", "[", "cuboid1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cuboid2Shape", "=", 
   RowBox[{"OpenCascadeShape", "[", "cuboid2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"shape", "=", 
  RowBox[{"OpenCascadeShapeSewing", "[", 
   RowBox[{"{", 
    RowBox[{"cylinderShape", ",", "cuboid1Shape", ",", "cuboid1Shape"}], 
    "}"}], "]"}]}]}], "Input",
 CellLabel->"In[697]:=",
 CellID->2130679380, ExpressionUUID->"f03e001f-12d2-4c59-84bb-5434b4ca0fe6"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8597", "]"}]], "Output",
 CellLabel->"Out[700]=",
 CellID->721686604, ExpressionUUID->"412fcc85-b06c-48bc-9eae-5f45abe8aa30"]
}, Open  ]]
}, Open  ]],

