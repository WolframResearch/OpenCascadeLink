Cell[TextData[{
 " ",
 Cell[BoxData["\<\"AngularDeflection\"\>"], "InlineFormula", ExpressionUUID->
  "6a5029ab-da0f-4f0d-be43-359d99a6dc0d"],
 " specifies the maximum deflection angle \[Alpha] at the end nodes of a \
segment while ",
 Cell[BoxData["\<\"LinearDeflection\"\>"], "InlineFormula", ExpressionUUID->
  "8d6ddc5b-ae07-4f44-b898-73cee69176a0"],
 " specifies the maximum deflection ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineMath", ExpressionUUID->
  "33157f62-014f-4c34-a671-1c30b72c1aca"],
 " to the true curve within a segment. The ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "f8088b7e-8fe3-4b20-be39-355b161fa77e"],
 " default for the ",
 Cell[BoxData["\<\"AngularDeflection\"\>"], "InlineFormula", ExpressionUUID->
  "e627704b-9bfb-4008-9341-ddb9f0f73dcf"],
 " is set to 0.5 degrees and the ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "ffdad19d-235f-458f-86f4-32869f630726"],
 " default for the ",
 Cell[BoxData["\<\"LinearDeflection\"\>"], "InlineFormula", ExpressionUUID->
  "b703280b-bc43-43d1-8f61-1c7546ffe357"],
 " is set to 0.01 units of the relative size of the shape. For more \
information please consult the ",
 ButtonBox["OpenCascade Documentation",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.opencascade.com/doc/occt-7.4.0/overview/html/occt_user_\
guides__modeling_algos.html#occt_modalg_11_2"], None},
  ButtonNote->
   "https://www.opencascade.com/doc/occt-7.4.0/overview/html/occt_user_guides_\
_modeling_algos.html#occt_modalg_11_2"],
 "."
}], "Text",
 CellID->1313654207, ExpressionUUID->"e1d3d6d5-374e-45d5-a77b-247a0afd6181"],

Cell[TextData[{
 Cell[BoxData["\<\"ComputeInParallel\"\>"], "InlineFormula", ExpressionUUID->
  "0db68f1c-aa85-4bf8-a597-e8b330d12eb1"],
 " specifies if the surface discretization should be performed on multiple \
CPU cores. The ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "9f29ad1d-88e5-4e25-9824-ccaa3eadc73b"],
 " default is set to ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "f2393a90-c937-46f5-9c3b-88930578469a"],
 "."
}], "Text",
 CellID->1024815173, ExpressionUUID->"aecd54e4-cab7-447c-afaa-8e7f014897ae"],

Cell[TextData[{
 Cell[BoxData["\<\"RelativeDeflection\"\>"], "InlineFormula", ExpressionUUID->
  "946d212c-6baa-491e-b347-d6ec29eb005e"],
 " specifies if the deflection is relative or absolute to the size of the \
geometry. The ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "d472910f-85d2-4a0b-90f9-9fd3692fe82b"],
 " default is set to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "ddb91541-26fe-4929-8d75-4fa99f5b73a5"],
 "."
}], "Text",
 CellID->280001579, ExpressionUUID->"1a7be08b-12cb-4266-9e35-fed32919e6fb"],

Cell[TextData[{
 Cell[BoxData["\<\"Rediscretization\"\>"], "InlineFormula", ExpressionUUID->
  "85aa92f4-5dcd-4ae8-932c-6e9941d8055e"],
 " specifies if one of the input shapes already as a discretization attached \
to it if that discretization is to be reused. The ",
 Cell[BoxData[
  ButtonBox["Automatic",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "094b7d6d-bb28-430b-aa1d-0b8079ce3167"],
 " default is set to ",
 Cell[BoxData[
  ButtonBox["False",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "604bef2b-5fd8-40f6-9f73-058bfdaf094a"],
 ". This functionality is useful to have different levels of discretization \
on different parts in a multi material object. An example is given below in \
the section ",
 ButtonBox["Internal boundaries refinement by sewing",
  BaseStyle->"Link",
  ButtonData->
   "paclet:OpenCascadeLink/tutorial/UsingOpenCascadeLink#1690964241"],
 "."
}], "Text",
 CellDingbat->Cell[
   BoxData[
    TooltipBox[
     Cell["13.3+", "ModInfo", "BrightFlag"], "13.3+"]], "ModInfoWrapper"],
 CellID->221215642, ExpressionUUID->"ebb44e7b-5c79-4a8a-8a97-9cc4381ebcb6"],

Cell[TextData[{
 "To make working with ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " and the finite element method easier a function to mesh the surface and \
return a boundary ",
 Cell[BoxData[
  ButtonBox["ElementMesh",
   BaseStyle->"Link",
   ButtonData->"paclet:FEMDocumentation/ref/ElementMesh"]], "InlineFormula",
  ShowStringCharacters->False, ExpressionUUID->
  "368de02e-c10e-4d15-afd7-dd9bedb09c9c"],
 " is provided."
}], "Text",
 CellID->331009014, ExpressionUUID->"b97575f7-d58d-4298-94d8-87060ee0fd02"],

Cell[CellGroupData[{

Cell[TextData[{
 "Extract a boundary ",
 Cell[BoxData[
  ButtonBox["ElementMesh",
   BaseStyle->"Link",
   ButtonData->"paclet:FEMDocumentation/ref/ElementMesh"]], "InlineFormula",
  ShowStringCharacters->False, ExpressionUUID->
  "6dbffedc-0e35-4aaa-ab1c-d52593b552eb"],
 " from the ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " shape."
}], "MathCaption",
 CellID->1002685763, ExpressionUUID->"51018bfe-82bf-43c8-b702-a243fb059745"],

