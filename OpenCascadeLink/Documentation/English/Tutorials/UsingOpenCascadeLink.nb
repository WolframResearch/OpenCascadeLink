Cell[CellGroupData[{

Cell["Shape splitting", "Subsection",
 CellID->264437419, ExpressionUUID->"3ec75dcb-dccd-45a8-9a1b-4bdd70456a44"],

Cell["\<\
When we have a shape, like a solid, sometimes we want to split that object \
into several parts. A solid can be split by another solid or by a face. The \
shape that is to be split is called the object and the shape that does the \
splitting is called the tool.\
\>", "Text",
 CellID->1102430809, ExpressionUUID->"4193413b-637f-4412-9bf5-ffaf0ba60377"],

Cell[CellGroupData[{

Cell["Define a shape that is to be split.", "MathCaption",
 CellID->224187749, ExpressionUUID->"0ed82947-4087-49b5-bf07-b2ead8eb67d4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"RegionDifference", "[", 
    RowBox[{
     RowBox[{"Cuboid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "]"}], ",", 
     RowBox[{"Cuboid", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.1", ",", "0.1", ",", "0.1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.9", ",", "0.9", ",", "0.9"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shape", "=", 
   RowBox[{"OpenCascadeShape", "[", "r", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[589]:=",
 CellID->413302431, ExpressionUUID->"3590d824-8a87-4bf1-af6d-1e6ace8bebf5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Define a shape that is the splitting tool.", "MathCaption",
 CellID->1192969248, ExpressionUUID->"b010bc4d-7dc7-4661-b741-865d7093f2ad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t", "=", 
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.5", ",", "0.5", ",", "0.5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1.5", ",", "1.5", ",", "1.5"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"tool", "=", 
  RowBox[{"OpenCascadeShape", "[", "t", "]"}]}]}], "Input",
 CellLabel->"In[591]:=",
 CellID->558723286, ExpressionUUID->"18a732cc-1aad-4df3-9995-f0006c16eca7"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8528", "]"}]], "Output",
 CellLabel->"Out[592]=",
 CellID->1177142920, ExpressionUUID->"0a6b2490-8635-4e55-8a98-b8a1be4bca08"]
}, Open  ]]
}, Open  ]],

