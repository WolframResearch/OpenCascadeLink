Cell[CellGroupData[{

Cell["Import a step file.", "MathCaption",
 CellID->1201268062, ExpressionUUID->"848a9c74-186f-4892-a7ca-553af192ab19"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"shape", "=", 
