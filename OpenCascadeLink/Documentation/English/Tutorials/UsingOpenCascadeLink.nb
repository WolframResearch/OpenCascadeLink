Cell["Both, open and closed surfaces can be converted.", "Text",
 CellID->1788261735, ExpressionUUID->"e8eec694-da5a-414a-a00b-ac9017d20600"],

Cell[CellGroupData[{

Cell["Create and visualize a boundary ElementMesh.", "MathCaption",
 CellID->879152758, ExpressionUUID->"13974540-8723-4042-8401-89b84192890f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"ImplicitRegion", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["x", "6"], "-", 
       RowBox[{"5", " ", 
        SuperscriptBox["x", "4"], " ", "y"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["x", "4"], " ", 
        SuperscriptBox["y", "2"]}], "+", 
       RowBox[{"10", " ", 
        SuperscriptBox["x", "2"], " ", 
        SuperscriptBox["y", "3"]}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["x", "2"], " ", 
        SuperscriptBox["y", "4"]}], "-", 
       SuperscriptBox["y", "5"], "+", 
       SuperscriptBox["y", "6"], "+", 
       SuperscriptBox["z", "2"]}], "\[LessEqual]", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"ToBoundaryMesh", "[", "r", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"bmesh", "[", "\"\<Wireframe\>\"", "]"}]}], "Input",
 CellLabel->"In[148]:=",
 CellID->1193335267, ExpressionUUID->"a7bbe8f4-0700-4e4e-b709-42179ca58880"],

