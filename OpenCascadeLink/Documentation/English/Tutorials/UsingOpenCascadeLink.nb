Cell[CellGroupData[{

Cell["Intersection", "Subsubsection",
 CellID->1299438469, ExpressionUUID->"6706c115-533c-4206-bc36-598157304a96"],

Cell["Compute geometric intersection of shapes.", "Text",
 CellID->437185105, ExpressionUUID->"6c034e80-5965-4988-a102-c373a0a0e69f"],

Cell[CellGroupData[{

Cell[TextData[{
 "Generate two ",
 Cell[BoxData[
  ButtonBox["Ball",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "565f2d25-0d29-4726-b503-e6022cb1057c"],
 " shapes."
}], "MathCaption",
 CellID->1221550800, ExpressionUUID->"c58ff39e-9db2-4192-abee-b2385af32823"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"b1", "=", 
   RowBox[{"Ball", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b2", "=", 
   RowBox[{"Ball", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], ",", "0"}], "}"}], ",", 
     RowBox[{"1", "/", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shape1", "=", 
   RowBox[{"OpenCascadeShape", "[", "b1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shape2", "=", 
   RowBox[{"OpenCascadeShape", "[", "b2", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[485]:=",
 CellID->550740042, ExpressionUUID->"3809502d-8bd1-4bfb-a7ea-71b89508f004"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute the geometric union.", "MathCaption",
 CellID->1455825753, ExpressionUUID->"eb883560-fbf2-42b5-a867-14543c9430a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"intersection", "=", 
  RowBox[{"OpenCascadeShapeIntersection", "[", 
   RowBox[{"shape1", ",", "shape2"}], "]"}]}]], "Input",
 CellLabel->"In[489]:=",
 CellID->607800443, ExpressionUUID->"643659f4-5c63-4c35-b88c-696e5d52d3d9"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8447", "]"}]], "Output",
 CellLabel->"Out[489]=",
 CellID->241070039, ExpressionUUID->"87495725-c2ad-4133-b51e-35e2d6c85ce8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Extract the boundary mesh.", "MathCaption",
 CellID->2022767250, ExpressionUUID->"46e5e4fd-9097-4d8c-8e47-5766db6244af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{
   "OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "intersection", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[490]:=",
 CellID->1638117143, ExpressionUUID->"48741c89-d737-4187-8a2b-93e6ec64f7e5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Look at the boundary element marker union and create colors for the markers.\
\>", "MathCaption",
 CellID->2032096595, ExpressionUUID->"ae96064b-d78d-479f-aa12-84fa76787c39"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"bmesh", "[", "\"\<BoundaryElementMarkerUnion\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temp", "=", 
   RowBox[{"Most", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "1", ",", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"Length", "[", "groups", "]"}], ")"}]}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"colors", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<BrightBands\>\"", "]"}], "[", "#", "]"}], 
    "&"}], "/@", "temp"}]}]}], "Input",
 CellLabel->"In[491]:=",
 CellID->730564740, ExpressionUUID->"43d5cc1f-7b9d-4058-a421-9e96ae293f8a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[<|"color" -> RGBColor[0.90222, 0.101808, 0.198306]|>,
    "RGBColorSwatchTemplate"], ",", 
   TemplateBox[<|
    "color" -> RGBColor[
      0.23499123809468608`, 0.9676036067435916, 0.1156329799245431]|>,
    "RGBColorSwatchTemplate"]}], "}"}]], "Output",
 CellLabel->"Out[493]=",
 CellID->1872852509, ExpressionUUID->"7dbd7af1-5fa9-4e69-ba89-222fcb3c12aa"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Visualize the boundary ",
 Cell[BoxData[
  ButtonBox["ElementMesh",
   BaseStyle->"Link",
   ButtonData->"paclet:FEMDocumentation/ref/ElementMesh"]], "InlineFormula",
  ShowStringCharacters->False, ExpressionUUID->
  "8a598be0-da6b-4c40-86e9-1aee9dd42680"],
 " with markers highlighted."
}], "MathCaption",
 CellID->330547481, ExpressionUUID->"d1f22d21-3de8-4742-b86f-2addb2ce8ac1"],

Cell[CellGroupData[{

Cell[BoxData[
