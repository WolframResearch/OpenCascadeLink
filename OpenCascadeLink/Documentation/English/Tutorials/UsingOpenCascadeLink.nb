Cell[CellGroupData[{

Cell[TextData[{
 "Look at the ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " shape type."
}], "MathCaption",
 CellID->703206595, ExpressionUUID->"a4be4fd7-0fc3-45b4-8ea3-a9c1d06058c6"],

Cell[CellGroupData[{

Cell[BoxData[
