Cell[TextData[{
 "The lowest dimensional argument to the ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " Boolean intersection operation was the face object. Since the resulting \
operation is also a face object the object information is present in the \
resulting shape object and can be meshed."
}], "Text",
 CellID->959007081, ExpressionUUID->"20f57530-3103-4f0e-953b-12b9b22d8354"],

