Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellID->1988338703, ExpressionUUID->"260a5b80-3c06-40dc-9823-674070731e31"],

Cell["\<\
In this example we show how 2D graphics primitives can be used for creating a \
boundary element mesh. We would like to create a multi material region with a \
cutout described by a Bezier curve.\
\>", "Text",
 CellID->422428027, ExpressionUUID->"45a6d9c4-3f6d-483c-acd5-0f1824f814c5"],

Cell[CellGroupData[{

Cell["Create graphics primitives.", "MathCaption",
 CellID->1158970400, ExpressionUUID->"d0100234-00e6-46a8-8aed-d2900d26064a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"angle", "=", 
   RowBox[{"2", 
    RowBox[{"\[Pi]", "/", "16"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r1", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r2", "=", "0.02"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"offset", "=", 
   RowBox[{"1", "/", "1000"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"faces", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Disk", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", "#", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "angle"}], "}"}]}], "]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"r1", ",", 
      RowBox[{"r1", "+", "offset"}], ",", "r2"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
