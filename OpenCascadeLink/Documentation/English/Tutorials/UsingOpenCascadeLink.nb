Cell[TextData[{
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " can perform rotational sweeps. For this a surface is rotated around an \
axis. The rotation can be less than a full rotation."
}], "Text",
 CellID->549159482, ExpressionUUID->"2417e9d6-439f-4675-ad9f-b72b13b18b25"],

