 CellID->1752062523, ExpressionUUID->"754ee781-d672-4d4e-9114-c5cfb1c84b54"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"shape1", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"SphericalShell", "[", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shape2", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Cylinder", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "2"}], ",", "3"}], "}"}]}], "}"}], ",", 
      RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[427]:=",
 CellID->722212945, ExpressionUUID->"4e64e672-7f54-4632-82a4-57982c811fb5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute the geometric difference of the shapes", "MathCaption",
 CellID->1877095552, ExpressionUUID->"3ca43346-6c15-45bd-baa3-15b7d024086d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"difference", "=", 
  RowBox[{"OpenCascadeShapeDifference", "[", 
   RowBox[{"shape1", ",", "shape2"}], "]"}]}]], "Input",
 CellLabel->"In[429]:=",
 CellID->883270464, ExpressionUUID->"22e35167-4ce8-4366-b071-c50a7b47aec4"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8394", "]"}]], "Output",
 CellLabel->"Out[429]=",
 CellID->1373864168, ExpressionUUID->"453703b6-e8b5-404b-877d-802a60d964f8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Extract the boundary mesh.", "MathCaption",
 CellID->11125773, ExpressionUUID->"2217e251-06f8-4de4-8715-9c9f9e36d3ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{
   "OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "difference", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[430]:=",
 CellID->1883612506, ExpressionUUID->"6cbcf965-4e73-4c81-b804-c5477f5f273a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Look at the boundary element marker union and create colors for the markers.\
\>", "MathCaption",
 CellID->1496504942, ExpressionUUID->"202bbe1d-0bbb-4c4e-a0be-1fbfd6c027ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"bmesh", "[", "\"\<BoundaryElementMarkerUnion\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temp", "=", 
   RowBox[{"Most", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "1", ",", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"Length", "[", "groups", "]"}], ")"}]}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"colors", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<BrightBands\>\"", "]"}], "[", "#", "]"}], 
    "&"}], "/@", "temp"}]}]}], "Input",
 CellLabel->"In[431]:=",
 CellID->1036313739, ExpressionUUID->"b690a7ef-57e0-4592-804c-e8517a130561"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[<|"color" -> RGBColor[0.90222, 0.101808, 0.198306]|>,
    "RGBColorSwatchTemplate"], ",", 
   TemplateBox[<|
    "color" -> RGBColor[0.14287214708202123`, 0.7165497398815136, 1.]|>,
    "RGBColorSwatchTemplate"], ",", 
   TemplateBox[<|
    "color" -> RGBColor[
      0.9729188047180777, 0.9391259962046635, 0.201748879675973]|>,
    "RGBColorSwatchTemplate"]}], "}"}]], "Output",
 CellLabel->"Out[433]=",
 CellID->1637544957, ExpressionUUID->"98e0dee8-bd44-431d-90a1-df5e3521d315"]
}, Open  ]]
}, Open  ]],

