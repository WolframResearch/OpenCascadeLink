Cell["\<\
By default, a loft created from wire objects will return an open shell. \
\>", "Text",
 CellID->229729930, ExpressionUUID->"e223c779-0e39-4c9d-827e-9d50fac1c227"],

Cell[CellGroupData[{

Cell["Inspect the shape type of the loft.", "MathCaption",
 CellID->773091839, ExpressionUUID->"c3039c05-d914-4100-83ea-43b51b19d65a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OpenCascadeShapeType", "[", "loft", "]"}]], "Input",
 CellLabel->"In[756]:=",
 CellID->1771701179, ExpressionUUID->"914cf672-8195-48ce-81aa-550925a402f6"],

Cell[BoxData["\<\"Shell\"\>"], "Output",
 CellLabel->"Out[756]=",
 CellID->406033106, ExpressionUUID->"ba9cc9b6-13c7-47c8-9ac9-d6507a5545d4"]
}, Open  ]]
}, Open  ]],

Cell["\<\
To generate a solid suitable for a full mesh generation set the option \
\"BuildSolid\"\[Rule]True.\
\>", "Text",
 CellID->1085419425, ExpressionUUID->"280a3f69-89cc-4d24-8d2a-998a3552e4d4"],

Cell[CellGroupData[{

Cell["Generate solid loft.", "MathCaption",
 CellID->1189314822, ExpressionUUID->"553b2294-5906-41eb-9d0a-60b61ae7e1c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"loft", "=", 
   RowBox[{"OpenCascadeShapeLoft", "[", 
    RowBox[{"s", ",", 
     RowBox[{"\"\<BuildSolid\>\"", "\[Rule]", "True"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"OpenCascadeShapeType", "[", "loft", "]"}]}], "Input",
 CellLabel->"In[757]:=",
 CellID->1041555252, ExpressionUUID->"0adb2f2a-de6d-4871-871f-b393d0c51e90"],

Cell[BoxData["\<\"Solid\"\>"], "Output",
 CellLabel->"Out[758]=",
 CellID->96225062, ExpressionUUID->"c3cdb727-55a1-4a9a-93df-3556119c0a33"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generate and visualize a full mesh.", "MathCaption",
 CellID->1187981597, ExpressionUUID->"c17c21ff-a5e8-4d82-9cfd-e96038a9d7aa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "loft", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"mesh", "=", 
  RowBox[{"ToElementMesh", "[", 
   RowBox[{"bmesh", ",", 
    RowBox[{"MaxCellMeasure", "\[Rule]", "Infinity"}]}], "]"}]}]}], "Input",
 CellLabel->"In[759]:=",
 CellID->1968824163, ExpressionUUID->"bad11d0d-85a7-49f8-9781-2740faec00e1"],

Cell[BoxData[
 TagBox[
  RowBox[{"ElementMesh", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.`", ",", "1.`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", "1.`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", "2.`"}], "}"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"TetrahedronElement", "[", 
      RowBox[{
       StyleBox["\<\"<\"\>",
        ShowStringCharacters->False], "\[InvisibleSpace]", "1291", "\[InvisibleSpace]", 
       StyleBox["\<\">\"\>",
        ShowStringCharacters->False]}], "]"}], "}"}]}], "]"}],
  False,
  Editable->False,
  SelectWithContents->True]], "Output",
 CellLabel->"Out[760]=",
 CellID->466847443, ExpressionUUID->"300a8d36-a33c-42fb-a38f-ff8dc08cc283"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visualize the mesh and the wires", "MathCaption",
 CellID->476296373, ExpressionUUID->"a84b5f12-dfcd-45f5-b684-a9db367df462"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"gr", ",", "\[IndentingNewLine]", 
   RowBox[{"mesh", "[", 
    RowBox[{"\"\<Wireframe\>\"", "[", 
     RowBox[{"\"\<MeshElementStyle\>\"", "\[Rule]", 
      RowBox[{"FaceForm", "[", "Orange", "]"}]}], "]"}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[761]:=",
 CellID->420950510, ExpressionUUID->"8596d5ad-0d84-436d-86a1-832bfba15ef4"],

