Cell[TextData[{
 "Sometimes it is convenient to walk through all edges and see the effect a \
chamfer has on the overall shape, or one needs to find the edge one wants to \
chamfer. For this purpose there is a helper function called ",
 Cell[BoxData[
 "VisualizeEdgeFunction"], "InlineFormula", ExpressionUUID->
  "e59acef6-c675-4e65-a0aa-c32f8478abaa"],
 " ",
 ButtonBox["defined in the appendix",
  BaseStyle->"Link",
  ButtonData->
   "paclet:OpenCascadeLink/tutorial/UsingOpenCascadeLink#1145909479"],
 " that does that."
}], "Text",
 CellID->647001921, ExpressionUUID->"751e183d-6aaa-4737-aa98-31097a4a74dd"],

Cell[CellGroupData[{

Cell["\<\
Interactively apply the chamfer function to edges of the shape.\
\>", "MathCaption",
 CellID->97045421, ExpressionUUID->"f58d49e0-76dc-4c4a-8348-2da96193711c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VisualizeEdgeFunction", "[", 
  RowBox[{
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], ",", 
   RowBox[{
    RowBox[{"OpenCascadeShapeChamfer", "[", 
     RowBox[{"#1", ",", "0.25", ",", "#2"}], "]"}], "&"}]}], "]"}]], "Input",
 CellLabel->"In[747]:=",
 CellID->1827203741, ExpressionUUID->"395e7599-97a0-410b-ab94-ee9d3e89ea5f"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`edge$$ = 1, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
    "\"untitled\"", Typeset`specs$$ = {{
      Hold[$CellContext`edge$$], 1, 24, 1, ControlType -> Manipulator}}, 
    Typeset`size$$ = {224.9582826200612, {213.3515625, 218.6484375}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = False, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`edge$$ = 1}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`shape$, $CellContext`newShape$}, \
$CellContext`shape$ = OpenCascadeLink`OpenCascadeShape[
           Cuboid[{0, 0, 0}, {1, 2, 3}]]; $CellContext`newShape$ = (
          OpenCascadeLink`OpenCascadeShapeChamfer[#, 
           0.25, #2]& )[$CellContext`shape$, $CellContext`edge$$]; Show[
          
          NDSolve`FEM`ElementMesh[{{0., 0., 0.}, {0., 0., 3.}, {0., 2., 0.}, {
           0., 2., 3.}, {1., 0., 0.}, {1., 0., 3.}, {1., 2., 0.}, {1., 2., 
           3.}}, Automatic, {
            NDSolve`FEM`TriangleElement[{{2, 3, 1}, {2, 4, 3}}, {1, 1}], 
            NDSolve`FEM`TriangleElement[{{6, 5, 7}, {6, 7, 8}}, {2, 2}], 
            NDSolve`FEM`TriangleElement[{{6, 1, 5}, {6, 2, 1}}, {3, 3}], 
            NDSolve`FEM`TriangleElement[{{8, 7, 3}, {8, 3, 4}}, {4, 4}], 
            NDSolve`FEM`TriangleElement[{{7, 1, 3}, {7, 5, 1}}, {5, 5}], 
            NDSolve`FEM`TriangleElement[{{8, 4, 2}, {8, 2, 6}}, {6, 6}]}, {
            
            NDSolve`FEM`PointElement[{{1}, {2}, {3}, {4}, {5}, {6}, {7}, {
             8}}, {7, 8, 9, 10, 11, 12, 13, 14}]}][
           "Edgeframe"["EdgeframeDirective" -> LightGray]], 
          If[$CellContext`newShape$ === $Failed, {}, 
           
           OpenCascadeLink`OpenCascadeShapeSurfaceMeshToBoundaryMesh[$\
CellContext`newShape$]["Edgeframe"]], PlotLabel -> 
          Style["Edge = " <> ToString[$CellContext`edge$$]]]], 
      "Specifications" :> {{$CellContext`edge$$, 1, 24, 1, Appearance -> 
         "Open"}}, "Options" :> {}, "DefaultOptions" :> {}],
     ImageSizeCache->{269.3582826200612, {265.5384375, 270.8353125}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>(Needs["OpenCascadeLink`"]; Typeset`initDone$$ = True),
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",
 CellLabel->"Out[747]=",
 CellID->84823848, ExpressionUUID->"8b551e5e-176b-4208-bab5-95a0f50d3ce0"]
}, Open  ]]
