Cell[TextData[{
 "A fully meshed ",
 Cell[BoxData[
  ButtonBox["ElementMesh",
   BaseStyle->"Link",
   ButtonData->"paclet:FEMDocumentation/ref/ElementMesh"]], "InlineFormula",
  ShowStringCharacters->False, ExpressionUUID->
  "fdbb471e-c022-4037-96ab-172817499f9b"],
 " can not be created from a non closed surface."
}], "Text",
 CellID->2104176976, ExpressionUUID->"74fe8ba5-84e6-4928-b6d1-df0258df1296"],

Cell["\<\
Closed B-splines are supported as long as the knots and weights are set to \
Automatic.\
\>", "Text",
