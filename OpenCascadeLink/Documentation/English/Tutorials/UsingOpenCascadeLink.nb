Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
 "OpenCascadeShapeSurfaceMeshToBoundaryMesh"], "InlineFormula", 
  ExpressionUUID->"42a99eab-9320-4a10-89e7-a5934d1a048c"],
 " has the following options:"
}], "MathCaption",
 CellID->1029851594, ExpressionUUID->"62232af1-35b5-40c9-be28-e65ac236627e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Options", "[", "OpenCascadeShapeSurfaceMeshToBoundaryMesh", 
  "]"}]], "Input",
 CellLabel->"In[313]:=",
 CellID->1821493419, ExpressionUUID->"1a8b7f9f-2bec-47d4-8211-1b9a17b7d191"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"ElementMeshOptions\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"MarkerMethod\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"ShapeSurfaceMeshOptions\"\>", "\[Rule]", "Automatic"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[313]=",
 CellID->1556890786, ExpressionUUID->"4afe33bf-2efc-4894-b9ac-e02efdc7d475"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "All options that are relevant for the ",
 Cell[BoxData[
  ButtonBox["ElementMesh",
   BaseStyle->"Link",
   ButtonData->"paclet:FEMDocumentation/ref/ElementMesh"]], "InlineFormula",
  ShowStringCharacters->False, ExpressionUUID->
  "074be803-3def-4614-aaf9-11416a807fa3"],
 " generation can be specified via ",
 Cell[BoxData["\<\"ElementMeshOptions\"\>"], "InlineFormula", ExpressionUUID->
  "5180fa4f-5d27-4fb3-85fd-8f57863d64bb"],
 " and options relevant for ",
 Cell[BoxData[
 "OpenCascadeShapeSurfaceMesh"], "InlineFormula", ExpressionUUID->
  "734112d9-41c6-44c8-bf5e-b6514ecab779"],
 " can be specified via ",
 Cell[BoxData["\<\"ShapeSurfaceMeshOptions\"\>"], "InlineFormula", 
  ExpressionUUID->"6950b7e5-833a-4bca-a573-3e0752ebbfff"],
 "."
}], "Text",
 CellID->676281114, ExpressionUUID->"d09676ba-3335-45ec-bc6b-f74b9d400a8c"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\<\"MarkerMethod\"\>"], "InlineFormula", ExpressionUUID->
  "cf1e932b-be2d-4a5e-950c-53519a2db939"],
 " option allows to specify if markers should be added and how they should be \
computed. The default is to use ",
 Cell[BoxData["\<\"OpenCascade\"\>"], "InlineFormula", ExpressionUUID->
  "1699b74e-3fa2-4869-bc72-3472012e5f6c"],
 ". Other options are ",
 Cell[BoxData["\<\"ElementMesh\"\>"], "InlineFormula", ExpressionUUID->
  "b7342d29-4d55-4203-b8ae-ffd00ea280b3"],
 " and ",
 Cell[BoxData[
  ButtonBox["None",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "38d693d8-7afe-4ef4-ac64-2bac6e06c62c"],
 " to switch off markers entirely. Using ",
 Cell[BoxData["\<\"ElementMesh\"\>"], "InlineFormula", ExpressionUUID->
  "3c7c3be2-3ca3-4c02-8a16-3437e73ac689"],
 " as a ",
 Cell[BoxData["\<\"MarkerMethod\"\>"], "InlineFormula", ExpressionUUID->
  "8c832de6-3998-446e-ad78-38f21f52738e"],
 " option can be useful if the generated surface consists of many single \
surface elements. In that case the ",
 Cell[BoxData["\<\"OpenCascade\"\>"], "InlineFormula", ExpressionUUID->
  "effda698-baa4-40e7-811e-7e862087acb8"],
 " method would attribute each element a unique marker which may be \
undesirable. With the method ",
 Cell[BoxData["\<\"ElementMesh\"\>"], "InlineFormula", ExpressionUUID->
  "4299a6b8-a361-49f2-bc0b-223a68db1d35"],
 ", however, the markers are added based on their face normals and if those \
deviate by a certain amount. The ",
 Cell[BoxData[
  ButtonBox["ToBoundaryMesh",
   BaseStyle->"Link",
   ButtonData->"paclet:FEMDocumentation/ref/ToBoundaryMesh#1024380926"]], 
  "InlineFormula",
  ShowStringCharacters->False, ExpressionUUID->
  "14b9dcb9-2e7d-4034-af85-33923f28ed2b"],
 " reference page has more information on this topic."
}], "Text",
 CellID->1621491766, ExpressionUUID->"11af4c04-0d6c-4d60-b5d1-4815c6c19f6d"],

Cell[CellGroupData[{

Cell[TextData[{
 "Extract a boundary ",
 Cell[BoxData[
  ButtonBox["ElementMesh",
   BaseStyle->"Link",
