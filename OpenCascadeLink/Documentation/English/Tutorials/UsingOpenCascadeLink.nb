       RowBox[{"2", ",", "2", ",", "0"}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b1", "=", 
   RowBox[{"Ball", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "10"}]}], "}"}], "]"}]}], ";"}]}], "Input",
