}, Open  ]],

Cell[TextData[{
 "A Boolean operation below the default OpenCascade tolerance of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]], TraditionalForm]], "InlineMath", ExpressionUUID->
  "afa349f2-34c9-483a-b7f1-5acfe500a8af"],
 " can lead to defects."
}], "Caption",
 CellID->861799510, ExpressionUUID->"f64f9024-cdf9-47c3-aa34-40b59a910e0a"],

Cell["A solution for this is to scale the geometry.", "Text",
 CellID->142539037, ExpressionUUID->"a0fb2c75-9f0f-4cb8-b195-56d3ee1bf68e"],

Cell[CellGroupData[{

Cell["Scale the geometry.", "MathCaption",
 CellID->682000480, ExpressionUUID->"aaf54e93-4744-4979-a2c6-9f6c9c6cc7b5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"scale", "=", 
   RowBox[{"10", "^", "6"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s1", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Ball", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"scale", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s2", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Ball", "[", 
     RowBox[{
      RowBox[{"scale", "*", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}], ",", "0", ",", "0"}], "}"}]}], ",", 
      RowBox[{"scale", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"OpenCascadeShapeUnion", "[", 
    RowBox[{"s1", ",", "s2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "s", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"bmesh", "[", 
  RowBox[{"\"\<Wireframe\>\"", "[", 
   RowBox[{"\"\<MeshElementStyle\>\"", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Opacity", "[", "0.5", "]"}], ",", 
       RowBox[{"FaceForm", "[", "LightGreen", "]"}]}], "}"}], "]"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[886]:=",
 CellID->1161625641, ExpressionUUID->"81477db4-e4b0-418c-9ba1-484cc3c8e7b3"],

