 Cell[BoxData[
 "OpenCascadeShapeSurfaceMesh"], "InlineFormula", ExpressionUUID->
  "5c5c6dcd-ea0d-4269-8f12-46fc1f24867f"],
 " has the following options:"
}], "MathCaption",
 CellID->295318819, ExpressionUUID->"e0712eb1-4fe4-4973-8798-bcbea07b6395"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Options", "[", "OpenCascadeShapeSurfaceMesh", "]"}]], "Input",
 CellLabel->"In[308]:=",
 CellID->639588860, ExpressionUUID->"77382e01-3b7e-4cd4-b4b0-e9239da75d2b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"AngularDeflection\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"ComputeInParallel\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"LinearDeflection\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"Rediscretization\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"RelativeDeflection\"\>", "\[Rule]", "Automatic"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[308]=",
 CellID->2068495507, ExpressionUUID->"d0cfb7f0-7d79-4403-9663-3b1635ebad6e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData["\<\"AngularDeflection\"\>"], "InlineFormula", ExpressionUUID->
  "6c156726-41dd-4886-85ee-fe68c50f5786"],
 " and ",
 Cell[BoxData["\<\"LinearDeflection\"\>"], "InlineFormula", ExpressionUUID->
  "88723baf-5374-4b77-a15b-140221350d16"],
 " specify the maximum amount a segment may deviate from the true surface. \
The concepts are best explained with the following illustration."
}], "Text",
 CellID->673531298, ExpressionUUID->"3da6a3b4-c1e0-4804-a4bc-8f310c0e99b9"],

Cell[BoxData[
 RowBox[{"Rotate", "[", 
  RowBox[{
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"x", "/", "2"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", 
         RowBox[{"4", "\[Pi]"}]}], "}"}], ",", 
       RowBox[{"Axes", "\[Rule]", "None"}], ",", 
       RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", 
         RowBox[{"Graphics", "[", 
           DynamicBox[
            FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]], 
           "]"}], 
         GridBox[{{
            RowBox[{
              TagBox["\"Byte count: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox["6168", "IconizedItem"]}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      Graphics[{{LightGray, 
         FilledCurve[{
           
           BezierCurve[{{2 Pi + 0.5, -0.3}, {2 Pi + 0.5 + 0.5, 0}, {
             2 Pi + 0.5, 0.3}}], 
           Line[{{2 Pi, 0}, {2 Pi + 0.5, -0.3}}]}]}, {
         Arrow[{{0, 0}, 3 {1, 1/Sqrt[3]}}]}, {Dashed, Gray, 
         Arrow[{{2 Pi, 0}, 3 {1, 1/Sqrt[3]} + 2 {Pi, 0}}]}, {
         Arrow[{{2 Pi, 0}, 3 {1, (-1)/Sqrt[3]} + 2 {Pi, 0}}]}, {
         Line[{{0, 0}, {2 Pi, 0}}]}, {Thick, 
         Point[{0, 0}], {
          Point[{2 Pi, 0}]}}, {Gray, 
         Line[{{Pi, 0}, {Pi, 1}}]}, {Gray, 
         EdgeForm[Gray], 
         FaceForm[], 
         Rectangle[{Pi, 0}, {Pi, 0} + 0.1]}, 
        Text["d", {Pi, 1/2}, {-2, 0}], 
        Text["\[Alpha]", {2 Pi, 0}, {-5, 0}]}],
      SelectWithContents->True,
      Selectable->False], "\[IndentingNewLine]", ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}], ",", 
   RowBox[{"0.05", "\[Pi]"}]}], "]"}]], "Input", "ExcludedMaterial",
 Evaluatable->False,
 CellID->137943143, ExpressionUUID->"a8e0240c-9a51-4b10-a853-543ea8804099"],

