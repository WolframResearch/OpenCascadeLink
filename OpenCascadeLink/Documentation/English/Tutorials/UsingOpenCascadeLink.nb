Cell[TextData[{
 "The conversion is computationally expensive since every surface element is \
mapped into an ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " object and then sewed together. This type of shape creation should only be \
used if no other approach can be found."
}], "Text",
 CellID->366019595, ExpressionUUID->"4ced3d6c-eb0b-43f3-8c81-fa27f681cdba"],

Cell[CellGroupData[{

Cell[TextData[{
 "Look at the ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " shape type."
}], "MathCaption",
 CellID->1682691958, ExpressionUUID->"4a1ee110-d2a8-4651-b54d-a728e0420342"],

