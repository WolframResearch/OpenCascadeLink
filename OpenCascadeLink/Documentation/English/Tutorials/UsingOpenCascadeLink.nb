Cell[CellGroupData[{

Cell["Union", "Subsubsection",
 CellID->2105679802, ExpressionUUID->"02aab813-d5fe-458e-830d-a03f36ee8b1c"],

Cell["Compute geometric unions of shapes.", "Text",
 CellID->911565105, ExpressionUUID->"7100783f-330c-4145-ac53-052bba28fed3"],

Cell[CellGroupData[{

Cell[TextData[{
 "Generate two ",
 Cell[BoxData[
  ButtonBox["Ball",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "deb0c4f3-c343-4c87-9994-6e128e2dd493"],
 " shapes."
}], "MathCaption",
 CellID->1671571639, ExpressionUUID->"a0476c18-73d7-45c7-888d-9a20e5a61904"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"b1", "=", 
   RowBox[{"Ball", "[", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b2", "=", 
   RowBox[{"Ball", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], ",", "0"}], "}"}], ",", 
     RowBox[{"1", "/", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shape1", "=", 
   RowBox[{"OpenCascadeShape", "[", "b1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shape2", "=", 
   RowBox[{"OpenCascadeShape", "[", "b2", "]"}]}], ";"}]}], "Input",
