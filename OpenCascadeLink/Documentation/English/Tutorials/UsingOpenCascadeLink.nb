Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8464", "]"}]], "Output",
 CellLabel->"Out[507]=",
 CellID->811102715, ExpressionUUID->"db729f4e-f13e-4ace-8382-52808d75ceb8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Extract the boundary mesh.", "MathCaption",
 CellID->459124298, ExpressionUUID->"bc233417-123d-4bfc-abbf-1b6a9be217b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{
   "OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "intersection", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[508]:=",
 CellID->247124166, ExpressionUUID->"ec8030ca-12cb-4769-9581-2df8d9fa14c3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Look at the boundary element marker union and create colors for the markers.\
\>", "MathCaption",
 CellID->733310535, ExpressionUUID->"87d5e112-9571-4adb-86dd-9524955c8236"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"bmesh", "[", "\"\<BoundaryElementMarkerUnion\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temp", "=", 
   RowBox[{"Most", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "1", ",", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"Length", "[", "groups", "]"}], ")"}]}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"colors", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<BrightBands\>\"", "]"}], "[", "#", "]"}], 
    "&"}], "/@", "temp"}]}]}], "Input",
 CellLabel->"In[509]:=",
 CellID->58244318, ExpressionUUID->"75e07870-9d53-44ca-8d11-2689621f3e37"],

