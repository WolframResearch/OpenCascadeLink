Cell[CellGroupData[{

Cell[TextData[{
 "Create a ",
 Cell[BoxData[
  ButtonBox["Ball",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "dfab4518-b4e3-4a81-9d84-9657a2a29f06"],
 " and a ",
 Cell[BoxData[
  ButtonBox["Pyramid",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "ad98c521-89fa-4b68-ada8-d586e1181ae8"],
 " shape."
}], "MathCaption",
 CellID->167302267, ExpressionUUID->"97cd512d-da62-4160-8174-b3bcbcfc0f24"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"shape1", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Ball", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shape2", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Pyramid", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "2", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "2"}], "}"}]}], "}"}], "-", "1"}], "]"}],
     "]"}]}], ";"}]}], "Input",
 CellLabel->"In[505]:=",
 CellID->127462193, ExpressionUUID->"477ccc1b-10dd-4e2b-a1cf-7745f573dea4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute the geometric intersection of the shapes", "MathCaption",
 CellID->968490803, ExpressionUUID->"1ea4199a-c9ae-4672-9904-cf74a85eb6d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"intersection", "=", 
  RowBox[{"OpenCascadeShapeIntersection", "[", 
   RowBox[{"shape1", ",", "shape2"}], "]"}]}]], "Input",
 CellLabel->"In[507]:=",
