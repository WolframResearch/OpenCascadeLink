            Map[ColorData[
              "BrightBands"][#]& , $CellContext`temp$]; $CellContext`newBmesh$[
             "Wireframe"[
             "MeshElementStyle" -> Map[FaceForm, $CellContext`colors$]]]], 
          PlotLabel -> Style["Face = " <> ToString[$CellContext`face$$]]]], 
