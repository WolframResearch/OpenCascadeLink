Cell[TextData[{
 "The way OpenCascadeLink supports ",
 Cell[BoxData[
  ButtonBox["FilledCurve",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "a28a69f3-1ae9-44a3-bd1b-3d028e5630c3"],
 ", and ",
 Cell[BoxData[
  ButtonBox["JoinedCurve",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "fb5e25e9-7fd6-44b9-82e8-5c15d3a0298a"],
 " for that matter, is a bit different from what they support in Graphics. \
For example, a Circle, can not be used as a segment in Graphics but it can be \
used in OpenCascadeLink."
}], "Text",
 CellID->644923192, ExpressionUUID->"42ef69b9-5e55-48e5-856f-4d16d47cfd3c"],

Cell[CellGroupData[{

Cell["Create a filled curve with a a Circle segment.", "MathCaption",
 CellID->430687007, ExpressionUUID->"1fdbe304-a1d3-414f-a5dc-341760de2e16"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fc", "=", 
  RowBox[{"FilledCurve", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Line", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
     RowBox[{"Circle", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "\[Pi]"}], "}"}]}], "]"}]}], "}"}], 
   "]"}]}]], "Input",
 CellLabel->"In[213]:=",
 CellID->2027936126, ExpressionUUID->"fea8db60-c065-4d87-8ff7-2fc9d43bac51"],

Cell[BoxData[
 RowBox[{"FilledCurve", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Line", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
    RowBox[{"Circle", "[", 
     RowBox[{
      RowBox[{"{", 
