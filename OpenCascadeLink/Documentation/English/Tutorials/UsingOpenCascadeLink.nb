Cell["\<\
Now, what if you want to refine the inner cylinder and not the boundary of \
the cuboids? Changing the linear or angular deflection during on the sewn \
object is going to affect all boundaries. To still change the discretization \
of a single shape in the object it is possible to surface mesh that object \
and retain that discretization during the sewing.\
\>", "Text",
 CellID->928277584, ExpressionUUID->"216e4787-55c2-4bed-a15d-a0b0e2cb25f1"],

Cell[CellGroupData[{

Cell["Discretize the cylinder:", "MathCaption",
 CellID->2047272484, ExpressionUUID->"cfe10b1d-06f1-49c2-bf4e-12c8ec460b01"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OpenCascadeShapeSurfaceMesh", "[", 
  RowBox[{"cylinderShape", ",", 
   RowBox[{"\"\<LinearDeflection\>\"", "->", "0.00125"}]}], "]"}]], "Input",
 CellLabel->"In[703]:=",
 CellID->134295631, ExpressionUUID->"497633a0-f63b-43a4-858a-fc58c9d2a6d7"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8594", "]"}]], "Output",
 CellLabel->"Out[703]=",
 CellID->1752486440, ExpressionUUID->"84c99dab-e01e-4f1f-95fa-4d704f8ff33b"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Note, that the discretization is attached to the ",
 Cell[BoxData[
 "OpenCascadeShapeExpression"], "InlineFormula", ExpressionUUID->
  "2075917f-cb14-40cf-9e4e-ca3f013abcae"],
 "."
}], "Text",
 CellID->1447123855, ExpressionUUID->"106fe7aa-aae5-4df8-af42-3253bde93227"],

Cell[CellGroupData[{

Cell["Sew the shapes together:", "MathCaption",
 CellID->1040957721, ExpressionUUID->"4c4bca20-9875-48cf-9b4f-3590552dfe7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"shape", "=", 
  RowBox[{"OpenCascadeShapeSewing", "[", 
   RowBox[{"{", 
    RowBox[{"cylinderShape", ",", "cuboid1Shape", ",", "cuboid2Shape"}], 
    "}"}], "]"}]}]], "Input",
 CellLabel->"In[704]:=",
 CellID->2025304543, ExpressionUUID->"d832cd4a-1cb4-4e8b-8ca6-96c5e1861b8f"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8598", "]"}]], "Output",
 CellLabel->"Out[704]=",
 CellID->32388626, ExpressionUUID->"b37212ea-39e9-4456-8fc0-be735fdc69a5"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "To make use of previous boundary discretizations attached to an ",
 Cell[BoxData[
 "OpenCascadeShapeExpression"], "InlineFormula", ExpressionUUID->
  "7e8cbce1-b33f-4165-b4fb-4b07b5651078"],
 " the ",
 Cell[BoxData[
 "OpenCascadeShapeSurfaceMeshToBoundaryMesh"], "InlineFormula", 
  ExpressionUUID->"6e2ef6ff-4c07-4e3c-b214-ada2424e0486"],
 " needs the option ",
 Cell[BoxData[
  RowBox[{"\<\"Rediscretization\"\>", "\[Rule]", 
   ButtonBox["False",
    BaseStyle->"Link"]}]], "InlineFormula", ExpressionUUID->
  "25723c53-6e71-4358-8b0f-cf534165b2bc"],
 " to make use of those previous discretizations if available."
}], "Text",
 CellID->674287346, ExpressionUUID->"ca09d906-5a1c-4496-8db6-0a042f1bdd68"],

Cell[CellGroupData[{

Cell[TextData[{
 "Create the boundary ",
 Cell[BoxData[
  ButtonBox["ElementMesh",
   BaseStyle->"Link",
   ButtonData->"paclet:FEMDocumentation/ref/ElementMesh"]], "InlineFormula",
  ShowStringCharacters->False, ExpressionUUID->
  "4f7d60d7-1fd6-45a4-ac81-1501b0ad7a8e"],
 " by not re-discretizeing if shapes already have a boundary discretization \
attached: "
}], "MathCaption",
 CellID->1513741008, ExpressionUUID->"3430b3c1-0102-416c-aef2-976190aec5d2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", 
    RowBox[{"shape", ",", 
     RowBox[{"\"\<ShapeSurfaceMeshOptions\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Rediscretization\>\"", "->", "False"}], "}"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"bmesh", "[", "\"\<Wireframe\>\"", "]"}]}], "Input",
 CellLabel->"In[705]:=",
 CellID->330351130, ExpressionUUID->"a40565ee-7b2a-4536-b4b0-3df1288f54d4"],

