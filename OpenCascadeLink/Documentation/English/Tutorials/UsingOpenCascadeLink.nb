Cell[CellGroupData[{

Cell["Circle in 3D", "Subsubsection",
 CellID->760299624, ExpressionUUID->"fcd8c47f-f800-449b-9eba-28affa72c4cb"],

Cell[CellGroupData[{

Cell["\<\
Visualize a circle that has it's center at {0,0,1} and a plane with a normal  \
in direction {0,-1,0}, a radius of 1/2 and an arc length from \[Pi] to 2 \
\[Pi].\
\>", "MathCaption",
 CellID->1324994461, ExpressionUUID->"6b9ae1ec-e9e2-45fd-89ac-87bc88db0b93"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics3D", "[", 
    RowBox[{"Circle3D", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], ",", 
      RowBox[{"1", "/", "2"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Pi]", ",", 
        RowBox[{"2", "\[Pi]"}]}], "}"}]}], "]"}], "]"}], ",", 
   RowBox[{"Axes", "\[Rule]", "True"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
