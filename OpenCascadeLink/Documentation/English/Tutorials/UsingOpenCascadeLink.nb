Cell[TextData[{
 "Boundary normals in ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " are in the opposite direction then what they are in the wolfram language. \
If an exported  STL shows signs of the normals being in the 'wrong' direction \
one can convert the shape to an ",
 Cell[BoxData[
  ButtonBox["ElementMesh",
   BaseStyle->"Link",
   ButtonData->"paclet:FEMDocumentation/ref/ElementMesh"]], "InlineFormula",
  ShowStringCharacters->False, ExpressionUUID->
  "ed2150f6-ef0b-4a8f-8963-39977770b65c"],
 " and that to a ",
 Cell[BoxData[
  ButtonBox["MeshRegion",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "7c37511b-360b-4916-aa3d-be9efd5fe6b0"],
 ". The ",
