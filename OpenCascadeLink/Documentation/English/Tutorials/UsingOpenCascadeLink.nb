 CellID->1093159932, ExpressionUUID->"14f1bf47-be2a-45a2-9bf7-3b13036af5ef"],

Cell[CellGroupData[{

Cell[TextData[{
 "Create and visualize a refined partial Torus primitive in ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 "."
}], "MathCaption",
 CellID->1477869295, ExpressionUUID->"aab3dc36-3cb6-42cb-95e7-281f78c5c63a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"shape", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"OpenCascadeTorus", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", "1", ",", 
      "0.1", ",", " ", 
      RowBox[{"\[Pi]", "/", "3"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", 
   RowBox[{"shape", ",", 
    RowBox[{"\"\<ShapeSurfaceMeshOptions\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<AngularDeflection\>\"", "->", "0.25"}], "}"}]}]}], "]"}], 
  "[", "\"\<Wireframe\>\"", "]"}]}], "Input",
 CellLabel->"In[97]:=",
 CellID->1512137192, ExpressionUUID->"3f969bf0-c397-412b-ba0b-158ef0cff306"],

