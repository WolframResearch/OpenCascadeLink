Cell[CellGroupData[{

Cell["JoinedCurve", "Subsubsection",
 CellID->2080711285, ExpressionUUID->"71b455b0-1c77-4eac-a4c9-0106ecf8b21f"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["JoinedCurve",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "37e717fc-86bc-4944-9dac-b2550addc14a"],
 " is not  a region primitive. The main reason this graphics operation is \
partially supported in ",
 StyleBox["OpenCascadeLink",
  FontSlant->"Italic"],
 " is that in current versions of Mathematica there is no way to create a \
connected region of 1D segments that are embedded in 2D."
}], "Text",
 CellID->189710147, ExpressionUUID->"d4e5601d-d071-4c13-88b8-46a3a9e6d4d4"],

Cell[CellGroupData[{

Cell["Create a boundary curve of 1D segments embedded in 2D.", "MathCaption",
 CellID->933606926, ExpressionUUID->"6f10e99c-5a75-43b8-874d-5863ad1d46f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"curves", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"BezierCurve", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
