Cell[TextData[{
 "Rotational sweeps can not be performed on Solid or CompoundSolid ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " shape types."
}], "Text",
 CellID->218753963, ExpressionUUID->"f15035f4-9ca5-4840-a759-3135e1ac1c15"],

Cell[CellGroupData[{

Cell["Possible Issues", "Subsubsubsection",
 CellID->1356543500, ExpressionUUID->"418e5ea1-e197-4b8c-9b47-6f9d72308235"],

Cell["\<\
Rotational sweeps can not be performed when the axis intersects the shape to \
be swept and that shape does not have a vertex or edge at the intersection. \
Consider an example.\
\>", "Text",
 CellID->2005556791, ExpressionUUID->"ef0d846f-5f15-4ce1-8373-3a92429974ee"],

Cell[CellGroupData[{

Cell[TextData[{
 "Create a Line primitive in ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 "."
}], "MathCaption",
 CellID->1904112883, ExpressionUUID->"1f76e421-0887-43cd-aa59-4357e738e3a5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"line", "=", 
   RowBox[{"Line", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"wire", "=", 
  RowBox[{"OpenCascadeShape", "[", "line", "]"}]}]}], "Input",
 CellLabel->"In[359]:=",
 CellID->694359257, ExpressionUUID->"f2fb8228-c706-4833-bace-bbaf9772f731"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8369", "]"}]], "Output",
 CellLabel->"Out[360]=",
 CellID->2058123303, ExpressionUUID->"8b08641d-5a74-4325-903e-dd9dd8eccdb4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Create an axis and visualize the line in 3D.", "MathCaption",
 CellID->736680926, ExpressionUUID->"f83f343f-dd31-4d10-beb3-95bc0081f1da"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"axis", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Graphics3D", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Red", ",", 
       RowBox[{"Thickness", "[", "0.02", "]"}], ",", "line"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Blue", ",", "Thick", ",", 
       RowBox[{"Arrow", "[", "axis", "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"Axes", "\[Rule]", "True"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[361]:=",
 CellID->977788035, ExpressionUUID->"5ff09d5d-1687-4ec5-978c-d779215979f2"],

Cell[BoxData[
 Graphics3DBox[{
   {RGBColor[1, 0, 0], Thickness[0.02], Line3DBox[{{-1, 0, 0}, {1, 0, 0}}]}, 
   {RGBColor[0, 0, 1], Thickness[Large], Arrow3DBox[{{0, 0, -1}, {0, 0, 1}}]}},
  Axes->True,
  AxesLabel->{
    FormBox["\"X\"", TraditionalForm], 
    FormBox["\"Y\"", TraditionalForm], 
    FormBox["\"Z\"", TraditionalForm]}]], "Output",
 CellLabel->"Out[362]=",
 CellID->363148920, ExpressionUUID->"aa3d4914-f887-4981-8934-b39acae83bef"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Failure of a sweep.", "MathCaption",
 CellID->516699963, ExpressionUUID->"c9a05283-b923-4fda-801a-ff862ba26fbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sweep", "=", 
  RowBox[{"OpenCascadeShapeRotationalSweep", "[", 
   RowBox[{"wire", ",", "axis", ",", "\[Pi]"}], "]"}]}]], "Input",
 CellLabel->"In[363]:=",
 CellID->1649691087, ExpressionUUID->"133dabd0-dba6-43c2-9ec6-ed249b70932c"],

Cell[BoxData["$Failed"], "Output",
 CellLabel->"Out[363]=",
 CellID->975265431, ExpressionUUID->"16c0a797-7303-4c65-820e-30dfd477c6fc"]
}, Open  ]]
}, Open  ]],

Cell["\<\
One way to fix this failure is to create a shape that has a vertex or edge \
along which the rotation is supposed to happen.\
\>", "Text",
 CellID->2013989968, ExpressionUUID->"3cc95eaa-f758-4dcd-a57b-3b5874fb77ea"],

Cell[CellGroupData[{

Cell["\<\
Insert a vertex at the intersection of the axis and the wire.\
\>", "MathCaption",
 CellID->1432993996, ExpressionUUID->"3ae729a4-93bd-45ed-869f-bcf1badc2830"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"line", "=", 
   RowBox[{"Line", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wire", "=", 
   RowBox[{"OpenCascadeShape", "[", "line", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sweep", "=", 
  RowBox[{"OpenCascadeShapeRotationalSweep", "[", 
   RowBox[{"wire", ",", "axis", ",", "\[Pi]"}], "]"}]}]}], "Input",
 CellLabel->"In[364]:=",
 CellID->363664058, ExpressionUUID->"7dedada4-dfd5-49da-afbd-afb7f627fa4b"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8372", "]"}]], "Output",
 CellLabel->"Out[366]=",
