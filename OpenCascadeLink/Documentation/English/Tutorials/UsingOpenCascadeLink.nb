Cell["\<\
Note that at the overlap where the two cuboids touched the union is not \
closed. This may be undesirable if one is working with a multiple material \
region. One option to close the face at the overlap is to compute the union \
of all faces of the solids.\
\>", "Text",
 CellID->1642122667, ExpressionUUID->"5097814f-e8e1-4a13-9956-4a361c4821c4"],

Cell[CellGroupData[{

Cell["\<\
Extract all faces from the solids and compute the union of the faces.\
\>", "MathCaption",
 CellID->1022975364, ExpressionUUID->"be71811d-f56f-40da-bb78-b4118cd90c74"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"faces1", "=", 
   RowBox[{"OpenCascadeShapeFaces", "[", "shape1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"faces2", "=", 
   RowBox[{"OpenCascadeShapeFaces", "[", "shape2", "]"}]}], ";"}], "\n", 
 RowBox[{"union", "=", 
  RowBox[{"OpenCascadeShapeUnion", "[", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{"faces1", ",", "faces2"}], "}"}], "]"}], "]"}]}]}], "Input",
 CellLabel->"In[671]:=",
 CellID->1474543784, ExpressionUUID->"57fef9b4-2a87-45a3-af3a-2a7398c84d81"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8588", "]"}]], "Output",
 CellLabel->"Out[673]=",
 CellID->2106934923, ExpressionUUID->"26d435a0-1b6c-43da-b392-527bdd9d0f88"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visualize the full mesh.", "MathCaption",
 CellID->2071445264, ExpressionUUID->"a6bc1233-ce61-4663-9297-a7eedbd52a3d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "union", "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ToElementMesh", "[", 
   RowBox[{"bmesh", ",", 
    RowBox[{"MaxCellMeasure", "\[Rule]", "0.01"}]}], "]"}], 
  "[", "\"\<Wireframe\>\"", "]"}]}], "Input",
 CellLabel->"In[674]:=",
 CellID->377819213, ExpressionUUID->"49b1e799-052e-4d23-a8e9-f15395a6a3ed"],

