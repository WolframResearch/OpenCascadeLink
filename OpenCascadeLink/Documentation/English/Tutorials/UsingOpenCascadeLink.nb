$CellContext`newBmesh$, $CellContext`groups$, $CellContext`temp$, \
$CellContext`colors$}, $CellContext`shape$ = 
         OpenCascadeLink`OpenCascadeShape[
           Cuboid[{0, 0, 0}]]; $CellContext`newShape$ = (
          OpenCascadeLink`OpenCascadeShapeShelling[#, 
           0.1, #2]& )[$CellContext`shape$, $CellContext`face$$]; Show[
          
