Cell[CellGroupData[{

Cell[TextData[{
 "Create a ",
 Cell[BoxData[
  ButtonBox["Ball",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "b0bc3ba1-c9dd-4fc6-b451-d3dabb5b729c"],
 " and a ",
 Cell[BoxData[
  ButtonBox["Hexahedron",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "3b6e03e0-ac49-468e-8c37-a0f0cacaf914"],
 " shape."
}], "MathCaption",
 CellID->976597186, ExpressionUUID->"7bfe580a-2be6-49d9-89a3-db10a4616d20"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"shape1", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Ball", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shape2", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Hexahedron", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[496]:=",
 CellID->1050005404, ExpressionUUID->"25436e9c-0f4b-41a0-a595-66b531c8f1d9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Compute the geometric intersection of the shapes", "MathCaption",
 CellID->1348835546, ExpressionUUID->"b709336a-a28f-42c4-9a60-74eaf1842bee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"intersection", "=", 
  RowBox[{"OpenCascadeShapeIntersection", "[", 
   RowBox[{"shape1", ",", "shape2"}], "]"}]}]], "Input",
 CellLabel->"In[498]:=",
 CellID->1537711585, ExpressionUUID->"fb60aede-559b-45a3-8ed9-29db6599ca63"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8456", "]"}]], "Output",
 CellLabel->"Out[498]=",
 CellID->30724005, ExpressionUUID->"7cea3f48-e6ce-41cc-a25f-8c5c144084c1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Extract the boundary mesh.", "MathCaption",
 CellID->1590903375, ExpressionUUID->"e025c58d-3e43-4529-9953-c782c70d26d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{
   "OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "intersection", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[499]:=",
 CellID->37349833, ExpressionUUID->"2ab67236-33d5-4bdd-9ee3-83cff793bc92"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Look at the boundary element marker union and create colors for the markers.\
\>", "MathCaption",
 CellID->120744097, ExpressionUUID->"0ef4b74c-caaa-46b2-a291-2878132b9216"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"bmesh", "[", "\"\<BoundaryElementMarkerUnion\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temp", "=", 
   RowBox[{"Most", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "1", ",", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"Length", "[", "groups", "]"}], ")"}]}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"colors", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<BrightBands\>\"", "]"}], "[", "#", "]"}], 
    "&"}], "/@", "temp"}]}]}], "Input",
 CellLabel->"In[500]:=",
 CellID->2074560435, ExpressionUUID->"deec8da9-a0d0-4850-ab97-30ca3df43377"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[<|"color" -> RGBColor[0.90222, 0.101808, 0.198306]|>,
    "RGBColorSwatchTemplate"], ",", 
   TemplateBox[<|
    "color" -> RGBColor[
      0.6308358608594066, 0.5593312522653415, 0.9997714945145527]|>,
    "RGBColorSwatchTemplate"], ",", 
   TemplateBox[<|
    "color" -> RGBColor[
      0.23499123809468608`, 0.9676036067435916, 0.1156329799245431]|>,
    "RGBColorSwatchTemplate"], ",", 
   TemplateBox[<|
    "color" -> RGBColor[
      0.9866205624332851, 0.9581441900989159, 0.4023413079796949]|>,
    "RGBColorSwatchTemplate"]}], "}"}]], "Output",
 CellLabel->"Out[502]=",
 CellID->1299235166, ExpressionUUID->"7a07620b-c514-4c35-9045-fd5a4b6864f4"]
}, Open  ]]
}, Open  ]],

