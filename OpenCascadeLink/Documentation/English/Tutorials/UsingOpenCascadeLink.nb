       RowBox[{"Opacity", "[", "0.5", "]"}], ",", 
       RowBox[{"c1", "=", 
        RowBox[{"Cuboid", "[", "]"}]}], ",", 
       RowBox[{"c2", "=", 
        RowBox[{"Cuboid", "[", 
