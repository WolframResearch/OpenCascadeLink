Cell[TextData[{
 "Sometimes it is convenient to walk through all faces and see the effect a \
shelling has on the overall shape, or one needs to find the face one wants to \
use for shelling. For this purpose there is a helper function called ",
 Cell[BoxData[
 "VisualizeFaceFunction"], "InlineFormula", ExpressionUUID->
  "305b549f-b644-46bf-a70c-1831f4a0e8aa"],
 " ",
 ButtonBox["defined in the appendix",
  BaseStyle->"Link",
  ButtonData->
   "paclet:OpenCascadeLink/tutorial/UsingOpenCascadeLink#953309557"],
 " that does that."
}], "Text",
 CellID->629842333, ExpressionUUID->"939da136-97b8-4569-af51-38e6d96ca9b1"],

