Cell[CellGroupData[{

Cell["Generate a shape.", "MathCaption",
 CellID->1757987397, ExpressionUUID->"73683c6a-1ee4-481b-87ad-7c43cd9c0a96"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"b1", "=", 
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"9", ",", "4", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b2", "=", 
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "1", ",", "2"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b3", "=", 
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"4", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"6", ",", "2", ",", "2"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"shapes", "=", 
   RowBox[{"OpenCascadeShape", "/@", 
    RowBox[{"{", 
     RowBox[{"b1", ",", "b2", ",", "b3"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{"shape", "=", 
  RowBox[{"OpenCascadeShapeDifference", "@@", "shapes"}]}]}], "Input",
 CellLabel->"In[780]:=",
 CellID->1926198198, ExpressionUUID->"eaf55e37-ef3b-4651-831a-2e99d011d245"],

