    "RGBColorSwatchTemplate"], ",", 
   TemplateBox[<|
    "color" -> RGBColor[
      0.9729188047180777, 0.9391259962046635, 0.201748879675973]|>,
    "RGBColorSwatchTemplate"], ",", 
   TemplateBox[<|
    "color" -> RGBColor[1., 0.5034084923371307, 0.0060676902730088965`]|>,
    "RGBColorSwatchTemplate"]}], "}"}]], "Output",
 CellLabel->"Out[474]=",
 CellID->1251119118, ExpressionUUID->"77794ef2-127c-45a8-9ee4-d79ce8214803"]
}, Open  ]]
}, Open  ]],

