Cell[CellGroupData[{

Cell["\<\
If the requested fillet radius is too large then the filleting will fail.\
\>", "Text",
 CellID->651093250, ExpressionUUID->"8425f2ec-ddef-48f2-8a49-7bcfd5c37d5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"shape", "=", 
  RowBox[{"OpenCascadeShape", "[", 
   RowBox[{"Cylinder", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[733]:=",
