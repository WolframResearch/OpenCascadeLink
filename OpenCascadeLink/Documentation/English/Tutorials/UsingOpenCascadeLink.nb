             8}}, {7, 8, 9, 10, 11, 12, 13, 14}]}][
           "Edgeframe"["EdgeframeDirective" -> LightGray]], 
          
          If[$CellContext`newShape$ === $Failed, {}, $CellContext`newBmesh$ = 
            OpenCascadeLink`OpenCascadeShapeSurfaceMeshToBoundaryMesh[$\
CellContext`newShape$]; $CellContext`groups$ = $CellContext`newBmesh$[
             "BoundaryElementMarkerUnion"]; $CellContext`temp$ = Most[
              Range[
