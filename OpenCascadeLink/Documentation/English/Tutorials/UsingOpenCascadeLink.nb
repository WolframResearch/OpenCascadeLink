Cell[CellGroupData[{

Cell["Solid 2D Primitives", "Subsection",
 CellID->2060703576, ExpressionUUID->"8c3dda93-c64e-4946-9e0a-c08946f88c5c"],

Cell[TextData[{
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " is a 3D CAD engine. With that being said, it is still possible to convert \
2D graphics primitives such as ",
 Cell[BoxData[
  ButtonBox["Disk",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "bb6637e9-88a4-4b7f-ad41-830d8ea6421d"],
 ", ",
 Cell[BoxData[
  ButtonBox["Rectangle",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "aa2dd347-dd74-456e-b200-61ee564f8666"],
 " etc to ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " shapes. There are two main reasons for doing this:"
}], "Text",
 CellID->1662512277, ExpressionUUID->"6dd3bd72-d175-4a9e-9a38-37b28508c0c5"],

Cell["The creation of a region might be simpler in 2D than in 3D", "Item",
 CellID->1567665676, ExpressionUUID->"b9ba5d4a-b9fd-4966-b988-14c8e22b98a8"],

Cell[TextData[{
 "Using the ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " engine for 2D boundary element mesh generation"
}], "Item",
 CellID->2111401125, ExpressionUUID->"e2f4e2d7-6c7c-4f38-ab94-66eb29ec0b95"],

Cell[TextData[{
 "The fundamental way this works is that 2D embedded objects are created in \
3D in the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineMath", ExpressionUUID->
  "5f7039ef-43ee-4cf5-b292-73ed7fa964c7"],
 "-",
 Cell[BoxData[
  FormBox["y", TraditionalForm]], "InlineMath", ExpressionUUID->
  "51faf516-1f74-4978-9f65-918cfc5fc8fb"],
 " plane and the ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]], "InlineMath", ExpressionUUID->
  "45d53fa5-b53b-4e9b-aade-4b8158bd030d"],
 "-value is assumed 0. Since the shapes created are embedded in 3D ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " operations like extrusion, Boolean operations etc can be applied in the \
same way as in the rest of the system."
}], "Text",
 CellID->219191988, ExpressionUUID->"5a8db658-6657-4aeb-ab51-aceaedad576d"],

Cell["We start by looking at a workflow.", "Text",
 CellID->491905058, ExpressionUUID->"c32dd50e-13ea-42b2-9645-d55abf8e8c52"],

Cell[CellGroupData[{

Cell["Workflow", "Subsubsection",
 CellID->2047557597, ExpressionUUID->"3ba75f1c-d93d-427b-8de9-f4d9499030f7"],

Cell["\<\
As a first step we illustrate a workflow for both scenarios. Let's start with \
creating a half disk.\
\>", "Text",
 CellID->1722700509, ExpressionUUID->"341f5ab2-1ef1-4174-a2d8-d8c5bd5653c6"],

Cell[CellGroupData[{

Cell["Create a half disk.", "MathCaption",
 CellID->957574915, ExpressionUUID->"561470ae-e48a-4415-83fd-f495d617a534"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"i", "=", 
  RowBox[{"OpenCascadeShape", "[", 
   RowBox[{"Disk", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "\[Pi]"}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1921604857, ExpressionUUID->"a9dfd68a-0707-4bb2-b30e-98bb15ccc1c5"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "4", "]"}]], "Output",
 CellLabel->"Out[5]=",
 CellID->1205149238, ExpressionUUID->"59cdca81-0701-41a1-bc5d-c479cae2de90"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Inspect the shape type.", "MathCaption",
 CellID->163129965, ExpressionUUID->"a326ed89-e6f4-42bd-bd28-cd701f47fc1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OpenCascadeShapeType", "[", "i", "]"}]], "Input",
 CellLabel->"In[6]:=",
 CellID->973116851, ExpressionUUID->"98d09ef6-4792-4c44-bd26-8c392eed5746"],

Cell[BoxData["\<\"Face\"\>"], "Output",
 CellLabel->"Out[6]=",
 CellID->1744722746, ExpressionUUID->"a8987be4-b349-4df2-9a28-13f47949e70e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Convert the OpenCascade shape into a boundary mesh.", "MathCaption",
 CellID->184235478, ExpressionUUID->"4e2fb3c7-f99e-45bb-83e7-2709c994fb47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bmesh", "=", 
  RowBox[{
  "OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "i", "]"}]}]], "Input",
 CellLabel->"In[7]:=",
 CellID->1447173129, ExpressionUUID->"86298272-15de-4b19-92f8-c03eefa048ff"],

Cell[BoxData[
 TagBox[
  RowBox[{"ElementMesh", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1.`"}], ",", "1.`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", "1.`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", "0.`"}], "}"}]}], "}"}], ",", "Automatic"}], "]"}],
  
  False,
  Editable->False,
  SelectWithContents->True]], "Output",
 CellLabel->"Out[7]=",
 CellID->1756235605, ExpressionUUID->"9e3d3dc5-2c77-42df-8cb3-d750ed96082a"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "Note that the boundary mesh generated is embedded in 3D and the ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]], "InlineMath", ExpressionUUID->
  "7f2b5ade-c2b9-4ea3-a107-0e9f7c6a59d2"],
 "-extend is 0. The projection of this mesh to 3D will be shown in a minute."
}], "Text",
 CellID->1177737065, ExpressionUUID->"d2462160-6537-4be1-8461-82a16c61433a"],

Cell[CellGroupData[{

Cell["Visualize the boundary mesh.", "MathCaption",
 CellID->1846747755, ExpressionUUID->"0a7e123e-f0e6-49d7-a2f2-fbc9373ea55e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"bmesh", "[", "\"\<Wireframe\>\"", "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"OpenCascadeAxis3D", "[", "]"}]}], "]"}]], "Input",
 CellLabel->"In[8]:=",
 CellID->1560978874, ExpressionUUID->"a75fc6dd-7b0e-4b65-9fb4-650704486e3b"],

Cell[BoxData[
 Graphics3DBox[{
   {EdgeForm[RGBColor[
    0.00010000076130382223`, 0.00010000076130382223`, 
