Cell[CellGroupData[{

Cell["Possible issues", "Section",
 CellID->169732034, ExpressionUUID->"a9e4de45-b44c-4907-b5b9-afc705c887d7"],

Cell[CellGroupData[{

Cell["Boolean operation issues", "Subsubsection",
 CellTags->"BooleanOperationIssues",
 CellID->613944054, ExpressionUUID->"f19b119b-4ab8-408b-8fa9-89067eeaf487"],

Cell[TextData[{
 "The lowest dimensional object that can be returned from an ",
 StyleBox["OpenCascase",
  FontSlant->"Italic"],
 " Boolean operation is that of the minimal dimension of any argument given \
to the Boolean operation. For example, a Boolean operation of two ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " solids can not return an ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " face object."
}], "Text",
 CellID->1838848405, ExpressionUUID->"516847e2-e028-4594-9589-093393d36df7"],

Cell[CellGroupData[{

Cell["Create two touching cubes.", "MathCaption",
 CellID->955024217, ExpressionUUID->"daff43bb-78c1-4ed6-98eb-01ab6b3b0f8a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Graphics3D", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Opacity", "[", "0.5", "]"}], ",", 
       RowBox[{"c1", "=", 
        RowBox[{"Cuboid", "[", "]"}]}], ",", 
       RowBox[{"c2", "=", 
        RowBox[{"Cuboid", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"1", "/", "2"}], ",", 
           RowBox[{"1", "/", "2"}]}], "}"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Red", ",", 
       RowBox[{"Polygon", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"1", "/", "2"}], ",", 
            RowBox[{"1", "/", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", 
            RowBox[{"1", "/", "2"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"1", "/", "2"}], ",", "1"}], "}"}]}], "}"}], "]"}]}], 
      "}"}]}], "}"}], ",", 
   RowBox[{"Boxed", "\[Rule]", "False"}]}], "]"}]], "Input",
 CellLabel->"In[864]:=",
 CellID->1470692694, ExpressionUUID->"e2588862-96b8-441e-b6df-6c7ded844aa3"],

Cell[BoxData[
 Graphics3DBox[{
   {Opacity[0.5], CuboidBox[{0, 0, 0}], 
