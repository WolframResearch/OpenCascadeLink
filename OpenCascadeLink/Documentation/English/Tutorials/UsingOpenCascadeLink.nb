 CellLabel->"In[179]:=",
 CellID->1612770411, ExpressionUUID->"8ea3738a-388d-4160-9fc9-c194fc2a6cd3"],

Cell[BoxData["\<\"Wire\"\>"], "Output",
 CellLabel->"Out[179]=",
 CellID->1444217351, ExpressionUUID->"de1b31fe-8a5e-4edc-a0a0-c6ef84241b28"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "A boundary ",
 Cell[BoxData[
  ButtonBox["ElementMesh",
   BaseStyle->"Link",
   ButtonData->"paclet:FEMDocumentation/ref/ElementMesh"]], "InlineFormula",
  ShowStringCharacters->False, ExpressionUUID->
  "f0cbfa0b-8b72-4c44-9101-8157377eae1e"],
 " can not be created from an ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " shape of type wire. Wire objects can, however, be used for rotational or \
linear sweeps or combined with other wire or edge objects."
}], "Text",
 CellID->1869468220, ExpressionUUID->"0de16804-69ac-42a5-b492-f73482ace68a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Surfaces from Edges", "Subsection",
 CellID->1628711797, ExpressionUUID->"7ebd4f51-445b-414e-945d-35387bb8137a"],

Cell["\<\
It's also possible to use wires to construct the boundary of surfaces. There \
are a few restrictions, however: Wires must not self intersect, the wires \
must form a closed loop and the surface that is to be formed must be planar.\
\>", "Text",
 CellID->2003815661, ExpressionUUID->"5c5a1a85-7659-4076-b1d2-5264215a7272"],

Cell[CellGroupData[{

Cell["Create several edge primitives.", "MathCaption",
 CellID->307224907, ExpressionUUID->"34f18c7c-c64c-46fa-ba48-2c571a673285"],

Cell[BoxData[
 RowBox[{
  RowBox[{"edges", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Line", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
     RowBox[{"OpenCascadeCircle", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"1", "/", "2"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}], ",", 
       RowBox[{"1", "/", "2"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", 
         RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"Line", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
     RowBox[{"Line", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], "]"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->"In[180]:=",
 CellID->1836212020, ExpressionUUID->"216aa696-35f9-4b83-b46f-62375082d25d"]
}, Open  ]],

