Cell["\<\
When a loft is generated from faces, a solid is returned automatically. \
\>", "Text",
 CellID->221056044, ExpressionUUID->"ba3eba3f-11f5-43e7-9e63-753a4c7365fe"],

Cell["Here is an example that creates a helix.", "Text",
 CellID->2107948465, ExpressionUUID->"25461121-5aa1-4f52-bcba-5b1982e598db"],

Cell[CellGroupData[{

Cell["Loft a helix from a set of circles:", "MathCaption",
 CellID->813377766, ExpressionUUID->"dbda92e4-3ac5-423b-ae5c-33bc59d02053"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "t_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"Cos", "[", 
       RowBox[{"10", "*", "t"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"10", "*", "t"}], "]"}]}], ",", 
     RowBox[{"t", "/", "4"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"circles", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"OpenCascadeCircle", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"f", "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"f", "'"}], "[", "t", "]"}]}], "}"}], ",", 
       RowBox[{"1", "/", "20"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", " ", "\[Pi]"}], ",", 
       RowBox[{"2", " ", 
        RowBox[{"\[Pi]", "/", "61"}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"OpenCascadeShape", "/@", "circles"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"loft", "=", 
   RowBox[{"OpenCascadeShapeLoft", "[", 
    RowBox[{"s", ",", 
     RowBox[{"\"\<BuildSolid\>\"", "->", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", 
    RowBox[{"loft", ",", 
     RowBox[{"\"\<ShapeSurfaceMeshOptions\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<AngularDeflection\>\"", "->", "0.15"}], "}"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"bmesh", "[", 
  RowBox[{"\"\<Wireframe\>\"", "[", 
   RowBox[{"\"\<MeshElementStyle\>\"", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{
      RowBox[{"FaceForm", "[", 
       RowBox[{"MaterialShading", "[", "\"\<Aluminum\>\"", "]"}], "]"}], ",", 
      
      RowBox[{"EdgeForm", "[", "]"}]}], "]"}]}], "]"}], "]"}]}], "Input",
