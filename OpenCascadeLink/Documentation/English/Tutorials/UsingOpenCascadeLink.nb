Cell[CellGroupData[{

Cell["Boundary 2D Primitives", "Subsection",
 CellID->1729064300, ExpressionUUID->"1001a991-917f-41a5-8c99-19be53bf6894"],

Cell[TextData[{
 "Just like solid 2D graphics primitives can be converted, as explained in \
the section ",
 ButtonBox["Solid 2D Primitives",
  BaseStyle->"Link",
  ButtonData->
   "paclet:OpenCascadeLink/tutorial/UsingOpenCascadeLink#2060703576"],
 ", we can also convert 2D edge or boundary graphics primitives such as ",
 Cell[BoxData[
  ButtonBox["Line",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "85423050-36a2-42fb-a8c0-b9d0467147e7"],
 " and ",
 Cell[BoxData[
  ButtonBox["Circle",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "d718b237-a320-44ed-a15e-307bc27b0c0d"],
 "."
}], "Text",
 CellID->1425133970, ExpressionUUID->"9838bbe2-9b0d-4188-b8ea-f05237887f10"],

Cell[TextData[{
 "The fundamental way this works is that 2D embedded objects are created in \
3D in the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineMath", ExpressionUUID->
  "c6b326a0-2f24-4b75-a8cb-7c70bc30e64a"],
 "-",
 Cell[BoxData[
  FormBox["y", TraditionalForm]], "InlineMath", ExpressionUUID->
  "8659f2a5-e004-4ea4-b5bd-b95e91111d66"],
 " plane and the ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]], "InlineMath", ExpressionUUID->
  "20da3e2b-6c4d-46a2-9c03-c921bd622dd8"],
 "-value is assumed 0. Since the shapes created are embedded in 3D ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " operations like extrusion, Boolean operations etc can be applied in the \
same way as in the rest of the system."
}], "Text",
 CellID->1995418632, ExpressionUUID->"2bca9fbd-578b-473f-acd7-426838d611f7"],

Cell[CellGroupData[{

Cell["Workflow", "Subsubsection",
 CellID->1731474679, ExpressionUUID->"771c0b4f-f2c6-4f74-8cfe-21f6781e313e"],

Cell["\<\
As a first step we illustrate a work flow for both scenarios. Let's start \
with creating a half circle and a line that closes the half circle.\
\>", "Text",
 CellID->49486509, ExpressionUUID->"748eaa0e-9b4e-4cfd-8a1b-a337aadaa516"],

Cell[CellGroupData[{

Cell["Create a half disk.", "MathCaption",
 CellID->652232622, ExpressionUUID->"99cca85d-e527-4d58-9f2f-ea7f1f57c550"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"i1", "=", 
  RowBox[{"OpenCascadeShape", "[", 
   RowBox[{"Circle", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "\[Pi]"}], "}"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
