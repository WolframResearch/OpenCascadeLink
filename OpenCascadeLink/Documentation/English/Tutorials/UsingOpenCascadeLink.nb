  ButtonBox["Export",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "425b9c86-bd94-4f37-926c-931391353e4f"],
 "."
}], "Text",
 CellID->107097813, ExpressionUUID->"2b83f359-bc9c-42e2-b374-e9e6ea428aa0"],

Cell[CellGroupData[{

Cell[TextData[{
 "Convert a shape to a ",
 Cell[BoxData[
  ButtonBox["MeshRegion",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "20b6f5a4-fa61-486f-af5a-dbf3f0ebf914"],
 " for STL export."
}], "MathCaption",
 CellID->194037810, ExpressionUUID->"4b941cbd-0e6d-44a1-ab46-33a6ece84ff9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fileName", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"$TemporaryDirectory", ",", "\"\<testMR.stl\>\""}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mr", "=", 
   RowBox[{"MeshRegion", "[", 
    RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "shape", "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"fileName", ",", "mr"}], "]"}]}], "Input",
 CellLabel->"In[814]:=",
