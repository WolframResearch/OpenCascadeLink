Cell[TextData[{
 "The lowest dimensional object that can be returned from an ",
 StyleBox["OpenCascase",
  FontSlant->"Italic"],
 " Boolean operation is that of the minimal dimension of any argument given \
to the Boolean operation. For example, a Boolean operation of two ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " solids can not return an ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " face object."
}], "Text",
 CellID->1504156903, ExpressionUUID->"1a535b6f-95f9-4467-a362-ee863cc11717"],

