Cell["It is also possible to fillet only selected edges.", "Text",
 CellID->1563798130, ExpressionUUID->"3dfb394a-1816-4b82-92a8-472c6bf7e0ec"],

Cell[CellGroupData[{

Cell["Generate a shape.", "MathCaption",
 CellID->2100860795, ExpressionUUID->"656e89e5-dd51-479d-afb3-8efb2229e719"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"shape", "=", 
  RowBox[{"OpenCascadeShape", "[", 
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[717]:=",
 CellID->1534420392, ExpressionUUID->"6044f805-4de1-4b2c-9fcd-613e49cc769f"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8603", "]"}]], "Output",
 CellLabel->"Out[717]=",
 CellID->1481746729, ExpressionUUID->"cfd6ac41-fade-4f64-ae03-3559cdde1823"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Look at the number of edges in the shape.", "MathCaption",
 CellID->123363997, ExpressionUUID->"1065336f-93e4-4b24-8c9b-93a4b59a9fb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OpenCascadeShapeNumberOfEdges", "[", "shape", "]"}]], "Input",
 CellLabel->"In[718]:=",
 CellID->299727519, ExpressionUUID->"ce85cedd-5b73-40fb-98b1-bdf3074e8b05"],

Cell[BoxData["24"], "Output",
 CellLabel->"Out[718]=",
 CellID->727165126, ExpressionUUID->"b332d814-8acd-4f85-8cce-a96947066425"]
}, Open  ]]
}, Open  ]],

Cell["\<\
In OpenCascade every face has access to all the edges the face is comprised \
of. In the case of the cube each face is connected to 4 edges. Since there \
are 6 faces this makes a total of 24 edges that can be addressed of which 12 \
are duplicated.\
\>", "Text",
 CellID->1953457395, ExpressionUUID->"d8b90c4f-7297-4de6-a836-b8cca2bee5e7"],

Cell[CellGroupData[{

Cell["Fillet edges number 1 and 7 with a radius of 0.25.", "MathCaption",
 CellID->2000848581, ExpressionUUID->"893da926-b9d8-48a1-8100-1c62ecbce64d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fillet", "=", 
  RowBox[{"OpenCascadeShapeFillet", "[", 
   RowBox[{"shape", ",", "0.25", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "7"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[719]:=",
 CellID->1085683251, ExpressionUUID->"0234377a-d917-4eaa-bb81-2fca76f2f864"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8604", "]"}]], "Output",
 CellLabel->"Out[719]=",
 CellID->609688448, ExpressionUUID->"079485ef-d50d-4f07-b2ec-ee5d1c57bd6f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Extract the boundary mesh.", "MathCaption",
 CellID->441290070, ExpressionUUID->"e7de49d6-084e-4e0b-9105-394dad2541bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bmesh", "=", 
  RowBox[{
  "OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "fillet", 
   "]"}]}]], "Input",
 CellLabel->"In[720]:=",
 CellID->1247164971, ExpressionUUID->"cd891b10-d833-4d65-975c-1aa736cbcf90"],

Cell[BoxData[
 TagBox[
  RowBox[{"ElementMesh", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.`", ",", "1.`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", "2.`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", "3.`"}], "}"}]}], "}"}], ",", "Automatic"}], "]"}],
  
  False,
  Editable->False,
  SelectWithContents->True]], "Output",
 CellLabel->"Out[720]=",
 CellID->250999604, ExpressionUUID->"e051f5df-8dd2-4663-a3e7-539f74cc9f1c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Look at the boundary element marker union and create colors for the markers.\
\>", "MathCaption",
 CellID->1110552763, ExpressionUUID->"25b963ef-ce05-4d76-aafe-398563de71ef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"bmesh", "[", "\"\<BoundaryElementMarkerUnion\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temp", "=", 
   RowBox[{"Most", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "1", ",", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"Length", "[", "groups", "]"}], ")"}]}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"colors", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<BrightBands\>\"", "]"}], "[", "#", "]"}], 
    "&"}], "/@", "temp"}]}]}], "Input",
 CellLabel->"In[721]:=",
 CellID->518395317, ExpressionUUID->"583b0bee-4a9e-4063-a13e-58896a30f9c4"],

