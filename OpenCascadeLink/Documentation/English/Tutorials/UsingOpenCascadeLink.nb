Cell[CellGroupData[{

Cell["\<\
Create and visualize an axis around which we will rotate the BSpline curve.\
\>", "MathCaption",
 CellID->1099207743, ExpressionUUID->"7575df73-3b21-4a57-8c87-ca27ad2ae480"],

Cell[CellGroupData[{

Cell[BoxData[{
