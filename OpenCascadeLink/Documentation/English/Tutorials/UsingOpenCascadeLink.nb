Cell[CellGroupData[{

Cell["Intersection", "Subsubsubsubsection",
 CellID->1370691270, ExpressionUUID->"049ccc1c-8045-4fa0-8611-6972341d2f4b"],

Cell[CellGroupData[{

Cell["Compute the intersection.", "MathCaption",
