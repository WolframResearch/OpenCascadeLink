Cell[CellGroupData[{

Cell["Tolerance issues", "Subsubsection",
 CellTags->"ToleranceIssues",
 CellID->682240191, ExpressionUUID->"df9c82fb-b774-4640-a4e2-547c3168e58f"],

Cell[TextData[{
 "The standard tolerance for OpenCascade is ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "6"}]], TraditionalForm]], "InlineMath", ExpressionUUID->
  "7937ecc0-2fe5-46a3-be9c-4e247243f240"],
 ". If you are dealing with geometries that have components in that scale it \
is recommenced to rescale the geometry. Once the geometry is generated then \
the boundary mesh can be rescaled again to the original scale."
}], "Text",
 CellID->851544316, ExpressionUUID->"93501870-3a9e-40f7-b648-2b9eb413a3e0"],

Cell[CellGroupData[{

Cell["\<\
Create and visualize a geometry below the standard OpenCascade tolerance.\
\>", "MathCaption",
 CellID->808048640, ExpressionUUID->"6e750dc5-2025-44b0-97ee-cb2955421bd7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"s1", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Ball", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s2", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Ball", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "8"}]}], ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"OpenCascadeShapeUnion", "[", 
    RowBox[{"s1", ",", "s2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", "s", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"bmesh", "[", 
  RowBox[{"\"\<Wireframe\>\"", "[", 
   RowBox[{"\"\<MeshElementStyle\>\"", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Opacity", "[", "0.5", "]"}], ",", 
       RowBox[{"FaceForm", "[", "LightGreen", "]"}]}], "}"}], "]"}]}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[881]:=",
 CellID->1370482095, ExpressionUUID->"db2d8d5e-99ca-4572-8545-48c0256247b3"],

