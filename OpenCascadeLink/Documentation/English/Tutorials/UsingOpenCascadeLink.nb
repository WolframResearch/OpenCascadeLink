Cell[CellGroupData[{

Cell["Internal boundaries refinement by sewing", "Subsubsection",
 CellDingbat->Cell[
   BoxData[
    TooltipBox[
     Cell["13.3+", "ModInfo", "BrightFlag"], "13.3+"]], "ModInfoWrapper"],
 CellID->1690964241, ExpressionUUID->"db209b14-cb6e-44a1-b481-09003789fd3e"],

Cell["\<\
Sometimes it is desirable to have different internal boundaries discretized \
at different resolutions. This can be achieved by discretizing the respective \
boundaries to a desired level and then sew them together.\
\>", "Text",
 CellID->1549407387, ExpressionUUID->"433d1cb2-b631-42ec-ac67-788e50d457c3"],

Cell[CellGroupData[{

Cell["Create symbolic regions:", "MathCaption",
 CellID->1874585343, ExpressionUUID->"6e0e955d-1fd7-4513-92de-de3cfff5478f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cylinder", "=", 
   RowBox[{"Cylinder", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "3.097"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", 
         RowBox[{"3.097", "+", "6"}]}], "}"}]}], "}"}], ",", "3"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cuboid1", "=", 
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
