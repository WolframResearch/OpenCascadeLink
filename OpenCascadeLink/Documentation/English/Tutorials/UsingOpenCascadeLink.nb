  DefaultBaseStyle->{
   "Graphics", 
    LightDarkAutoColorRules -> <|"MarkedColors" -> True|>}]], "Output",
 CellLabel->"Out[14]=",
 CellID->2132920935, ExpressionUUID->"68e41117-031d-485f-ae7b-866e47ff790d"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The boundary mesh refinement works in the standard way. This is described \
in more detail in the section ",
 ButtonBox["Surface mesh generation",
  BaseStyle->"Link",
  ButtonData->
   "paclet:OpenCascadeLink/tutorial/UsingOpenCascadeLink#2068564608"],
 "."
}], "Text",
 CellID->1681015807, ExpressionUUID->"237392cc-62c6-4dea-a2c6-726c608c6a1f"],

Cell[CellGroupData[{

Cell["\<\
Create a half disk, generate a refined boundary mesh and project the mesh to \
2D.\
\>", "MathCaption",
 CellID->67304730, ExpressionUUID->"ff2bf3ff-74c0-4122-a210-06b749a74a7d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"i", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Disk", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "\[Pi]"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bmesh", "=", 
   RowBox[{"OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", 
    RowBox[{"i", ",", 
     RowBox[{"\"\<ShapeSurfaceMeshOptions\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<AngularDeflection\>\"", "->", "0.1"}], "}"}]}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ElementMeshProjection", "[", 
   RowBox[{"bmesh", ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}]}], "]"}], 
  "[", "\"\<Wireframe\>\"", "]"}]}], "Input",
 CellLabel->"In[15]:=",
 CellID->1705857331, ExpressionUUID->"ccc9c169-1d31-4e9a-82f0-4ad5f8ccdc07"],

