Cell[CellGroupData[{

Cell["Generate a shape.", "MathCaption",
 CellID->2034029960, ExpressionUUID->"5da43380-205b-4e18-8162-37c8d7cc4451"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"face", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Polygon", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sweep", "=", 
   RowBox[{"OpenCascadeShapeRotationalSweep", "[", 
    RowBox[{"face", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"-", "3"}], 
      RowBox[{"\[Pi]", "/", "2"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shape1", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Cylinder", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], "}"}], ",", 
      RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"shape", "=", 
  RowBox[{"OpenCascadeShapeUnion", "[", 
   RowBox[{"sweep", ",", "shape1"}], "]"}]}]}], "Input",
 CellLabel->"In[726]:=",
 CellID->1649272303, ExpressionUUID->"1e5fa5a5-e4f3-4e4b-8dcd-2054232c78e8"],

Cell[BoxData[
 RowBox[{"OpenCascadeShapeExpression", "[", "8611", "]"}]], "Output",
 CellLabel->"Out[729]=",
 CellID->1285931626, ExpressionUUID->"9b514d74-6011-4def-bf54-cb2ce3acb322"]
}, Open  ]]
}, Open  ]],

