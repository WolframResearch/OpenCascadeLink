 CellID->953309557, ExpressionUUID->"39a03782-8cdf-4ca8-b6a6-2e8bcbaa8d34"],

Cell[TextData[{
 "The function ",
 Cell[BoxData[
 "VisualizeFaceFunction"], "InlineFormula", ExpressionUUID->
  "213d162b-bacb-49eb-9b4e-4da54ee5cb9e"],
 " can be used to scroll through the faces of a region and apply a face \
operation."
}], "Text",
 CellID->514058813, ExpressionUUID->"10561d08-b802-42ab-bc00-96d22fc51b7c"],

Cell[CellGroupData[{

Cell["\<\
A utility function to interactively visualize face operations.\
\>", "MathCaption",
 CellID->935639308, ExpressionUUID->"8ec3766e-423b-467a-a2c2-5fed668b5dd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VisualizeFaceFunction", "[", 
   RowBox[{"region_", ",", "funIn_"}], "]"}], ":=", 
  RowBox[{"With", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fun", "=", "funIn"}], ",", 
      RowBox[{"ishape", "=", 
       RowBox[{"OpenCascadeLink`OpenCascadeShape", "[", "region", "]"}]}]}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"With", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"numFaces", "=", 
         RowBox[{
         "OpenCascadeLink`OpenCascadeShapeNumberOfFaces", "[", "ishape", 
          "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"bmesh", "=", 
         RowBox[{
         "OpenCascadeLink`OpenCascadeShapeSurfaceMeshToBoundaryMesh", "[", 
          "ishape", "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Manipulate", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "shape", ",", "newShape", ",", "newBmesh", ",", "groups", ",", 
            "temp", ",", "colors"}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"shape", "=", 
            RowBox[{
            "OpenCascadeLink`OpenCascadeShape", "[", "region", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"newShape", "=", 
            RowBox[{"fun", "[", 
             RowBox[{"shape", ",", "face"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Show", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"bmesh", "[", 
              RowBox[{"\"\<Edgeframe\>\"", "[", 
               RowBox[{"\"\<EdgeframeDirective\>\"", "->", "LightGray"}], 
               "]"}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"newShape", "===", "$Failed"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", "}"}], "\[IndentingNewLine]", ",", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"newBmesh", "=", 
                 RowBox[{
                 "OpenCascadeLink`OpenCascadeShapeSurfaceMeshToBoundaryMesh", 
                  "[", "newShape", "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"groups", "=", 
                 RowBox[{
                 "newBmesh", "[", "\"\<BoundaryElementMarkerUnion\>\"", 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"temp", "=", 
                 RowBox[{"Most", "[", 
                  RowBox[{"Range", "[", 
                   RowBox[{"0", ",", "1", ",", 
                    RowBox[{"1", "/", 
                    RowBox[{"(", 
                    RowBox[{"Length", "[", "groups", "]"}], ")"}]}]}], "]"}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"colors", "=", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"ColorData", "[", "\"\<BrightBands\>\"", "]"}], "[",
                     "#", "]"}], "&"}], "/@", "temp"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"newBmesh", "[", 
                 RowBox[{"\"\<Wireframe\>\"", "[", 
                  RowBox[{"\"\<MeshElementStyle\>\"", "\[Rule]", 
                   RowBox[{"FaceForm", "/@", "colors"}]}], "]"}], "]"}]}]}], 
              "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
             RowBox[{"PlotLabel", "->", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<Face = \>\"", "<>", 
                RowBox[{"ToString", "[", "face", "]"}]}], "]"}]}]}], 
            "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"face", ",", "1", ",", "numFaces", ",", "1", ",", 
          RowBox[{"Appearance", "\[Rule]", "\"\<Open\>\""}]}], "}"}], ",", 
        RowBox[{"Initialization", ":>", 
         RowBox[{"(", 
          RowBox[{"Needs", "[", "\"\<OpenCascadeLink`\>\"", "]"}], ")"}]}]}], 
       "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellLabel->"In[4]:=",
 CellID->757924959, ExpressionUUID->"e35e7f07-b382-4e53-9162-4f5f4652fd06"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

