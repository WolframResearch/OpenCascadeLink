Cell[CellGroupData[{

Cell["FilledCurve", "Subsubsection",
 CellID->307291349, ExpressionUUID->"d16e2752-fd22-4d72-8fe6-4417d9d3dc5c"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["FilledCurve",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "e57e918b-9f62-4020-88f9-25072b4af98e"],
 " is not  a region primitive. The main reason this graphics operation is \
partially supported in ",
 StyleBox["OpenCascadeLink",
  FontSlant->"Italic"],
 " is that in current versions of Mathematica there is no way to create a 2D \
region by connecting 1D segments that are embedded in 2D."
}], "Text",
 CellID->310104559, ExpressionUUID->"3169653f-6b13-4abb-a967-0a330c12f964"],

Cell[CellGroupData[{

Cell["Create a boundary curve of 1D segments embedded in 2D.", "MathCaption",
 CellID->985525404, ExpressionUUID->"f01c1eb5-08f2-49b4-ac7d-2dd8447c43a8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"curves", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"BezierCurve", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
     RowBox[{"Line", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"-", "2"}], "/", "3"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}], "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Graphics", "[", "curves", "]"}]}], "Input",
 CellLabel->"In[206]:=",
 CellID->349339000, ExpressionUUID->"ded33f48-0e84-4120-8213-0198a72bee55"],

Cell[BoxData[
 GraphicsBox[{BezierCurveBox[{{-1, 0}, {0, 1}, {1, 0}}], 
   LineBox[NCache[{{1, 0}, {0, Rational[-2, 3]}, {-1, 0}}, {{1, 0}, {
      0, -0.6666666666666666}, {-1, 0}}]]}]], "Output",
 CellLabel->"Out[207]=",
 CellID->466518569, ExpressionUUID->"878ea8b2-38b3-4680-bd24-1c652b200f7c"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "For graphics ",
 Cell[BoxData[
  ButtonBox["FilledCurve",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "c5622a46-a14e-409c-9f24-5b5e1e83e98d"],
 " can be used to mean the region that is enclosed by the curve."
}], "Text",
 CellID->340292980, ExpressionUUID->"a7ed1a38-3761-48a3-874a-d2e186ea028b"],

Cell[CellGroupData[{

Cell[TextData[{
 "Create 2D ",
