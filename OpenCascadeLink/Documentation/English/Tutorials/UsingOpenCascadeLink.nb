Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"parts", "=", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"mesh", "[", 
      RowBox[{"\"\<Wireframe\>\"", "[", 
       RowBox[{
        RowBox[{"ElementMarker", "\[Equal]", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<MeshElement\>\"", "\[Rule]", "\"\<MeshElements\>\""}], ",", 
        RowBox[{"\"\<ElementMeshDirective\>\"", "\[Rule]", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"EdgeForm", "[", "]"}], ",", 
           RowBox[{"FaceForm", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}]}], "]"}], "]"}],
      "&"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "Gray"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "Pink"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "Orange"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
