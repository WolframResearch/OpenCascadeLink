Cell[TextData[{
 "It is also possible to apply 3D transformations, as the underlying shape \
expression is embedded in 3D with the ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]], "InlineMath", ExpressionUUID->
  "d850180a-c8e4-49d6-b897-902ab1ed9a16"],
 " axis set to 0."
}], "Text",
 CellID->1559451092, ExpressionUUID->"bfcbec7f-d1ea-4d65-900e-05584b71435b"],

Cell[CellGroupData[{

Cell["Create a 3D transformation function.", "MathCaption",
 CellID->1798768362, ExpressionUUID->"69d8f20c-4735-4d52-8b4b-c8760cec1f16"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tf", "=", 
  RowBox[{"RotationTransform", "[", 
   RowBox[{
    RowBox[{"\[Pi]", "/", "2"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[266]:=",
 CellID->584562672, ExpressionUUID->"93e70e63-6e3b-447d-aa04-75088e2419a3"],

Cell[BoxData[
 RowBox[{"TransformationFunction", "[", 
  RowBox[{"(", 
   TagBox[GridBox[{
      {"1", "0", "0", "0"},
      {"0", "0", 
       RowBox[{"-", "1"}], "0"},
      {"0", "1", "0", "0"},
      {"0", "0", "0", "1"}
     },
     AutoDelete->False,
     GridBoxDividers->{
      "Columns" -> {{False}}, "ColumnsIndexed" -> {-2 -> True}, 
       "Rows" -> {{False}}, "RowsIndexed" -> {-2 -> True}},
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
    #& ], ")"}], "]"}]], "Output",
 CellLabel->"Out[266]=",
 CellID->1821258349, ExpressionUUID->"b148b49c-127a-4f16-b57b-aac94422027a"]
}, Open  ]]
}, Open  ]],

