   TemplateBox[<|
    "color" -> RGBColor[
      0.6091400306115944, 0.9924863936620901, 0.45551440491106865`]|>,
    "RGBColorSwatchTemplate"], ",", 
   TemplateBox[<|
    "color" -> RGBColor[
      0.9866205624332851, 0.9581441900989159, 0.4023413079796949]|>,
