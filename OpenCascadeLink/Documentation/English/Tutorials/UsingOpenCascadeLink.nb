Cell[TextData[{
 "A possible issue is that ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " is sensitive to the ordering of the surfaces given for sewing. This may be \
tricky to note as a displayed surface might look good but when, for example, \
Boolean operations are performed on the object unexpected results may \
happen."
}], "Text",
 CellID->1003448612, ExpressionUUID->"ad5a6022-3048-4d84-97c0-d02cf69d7089"],

Cell[CellGroupData[{

Cell["Compute the Boolean union of a the ellipsoid and a cuboid.", \
"MathCaption",
 CellID->777896331, ExpressionUUID->"c7ec211f-9e85-4b41-96c7-6e5bd3b9eacb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cu", "=", 
   RowBox[{"OpenCascadeShape", "[", 
    RowBox[{"Cuboid", "[", 
     RowBox[{
      RowBox[{"{", 
