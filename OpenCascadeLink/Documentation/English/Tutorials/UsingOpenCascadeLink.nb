  RowBox[{"groups", "=", 
   RowBox[{"bmesh", "[", "\"\<BoundaryElementMarkerUnion\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temp", "=", 
   RowBox[{"Most", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "1", ",", 
