    "color" -> RGBColor[
      0.9807483805553391, 0.9499935355728077, 0.316373124420957]|>,
    "RGBColorSwatchTemplate"], ",", 
   TemplateBox[<|
    "color" -> RGBColor[1., 0.5386004220032548, 0.07679844880543597]|>,
    "RGBColorSwatchTemplate"]}], "}"}]], "Output",
 CellLabel->"Out[465]=",
