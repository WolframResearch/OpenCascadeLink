Cell[CellGroupData[{

Cell["Export the shape as a STL file.", "MathCaption",
 CellID->498206678, ExpressionUUID->"2efb43c9-f0e3-4540-8b52-f81a5c3963ee"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fileName", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"$TemporaryDirectory", ",", "\"\<test.stl\>\""}], "}"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"OpenCascadeShapeExport", "[", 
  RowBox[{"fileName", ",", "shape"}], "]"}]}], "Input",
