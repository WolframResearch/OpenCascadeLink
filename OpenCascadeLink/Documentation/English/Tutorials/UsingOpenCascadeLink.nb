Cell[CellGroupData[{

Cell[TextData[{
 "Extract the coordinates from the ",
 Cell[BoxData[
  ButtonBox["PolarPlot",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "e1711a1b-a6d8-4029-9d8c-b7ac96bec700"],
 "."
}], "MathCaption",
 CellID->1420648156, ExpressionUUID->"4d5bdf08-2a4e-4a9f-907c-3e18b21c2ff3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coordinates", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "pp", "]"}], ",", 
      RowBox[{
       RowBox[{"Line", "[", "l_", "]"}], "\[RuleDelayed]", "l"}], ",", 
      "\[Infinity]"}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[626]:=",
 CellID->1219804566, ExpressionUUID->"cb52aa08-d9d9-4470-a37e-14c4e85792f2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Make use of a function to parameterize the coordinates of the shape.\
\>", "MathCaption",
 CellID->1472016307, ExpressionUUID->"5c24c84c-3782-4770-9a28-951258de8cbe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"parametrizeCurve", "[", 
   RowBox[{"pts_List", ",", 
    RowBox[{"a", ":", 
     RowBox[{"(", 
      RowBox[{"_", "?", "NumericQ"}], ")"}], ":", 
     RowBox[{"1", "/", "2"}]}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"FoldList", "[", 
    RowBox[{"Plus", ",", "0", ",", 
     RowBox[{"Normalize", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Norm", "/@", 
          RowBox[{"Differences", "[", "pts", "]"}]}], ")"}], "^", "a"}], ",", 
       "Total"}], "]"}]}], "]"}], "/;", 
   RowBox[{"MatrixQ", "[", 
    RowBox[{"pts", ",", "NumericQ"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tvals", "=", 
   RowBox[{"parametrizeCurve", "[", 
    RowBox[{"coordinates", ",", "1"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[627]:=",
 CellID->681995046, ExpressionUUID->"beeb9ede-8f8c-4c79-bf03-d97b5de24fe6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Construct the ",
 Cell[BoxData[
  ButtonBox["BSplineSurface",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "a0b7801d-6d7e-44c5-9735-f988c6be5569"],
 "."
}], "MathCaption",
 CellID->1568484282, ExpressionUUID->"67f6a77e-18ee-44f5-80ee-e985a26dfc75"],

Cell["\<\
bottom = ArrayPad[coordinates,{{0,0},{0,1}},-1.];
top = ArrayPad[coordinates,{{0,0},{0,1}},2.];
knots = Join[{0.,0.},tvals[[2;;-2]],{1.,1.}];
bss = BSplineSurface[Transpose[{bottom,top}],SplineDegree\[Rule]1,SplineKnots\
\[Rule]{knots,{0,0,1,1}}];\
\>", "Input",
 CellLabel->"In[629]:=",
 CellID->1670802241, ExpressionUUID->"05294b63-079e-406d-b0cd-64137d8f267c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Visualize the ",
 Cell[BoxData[
  ButtonBox["BSplineSurface",
   BaseStyle->"Link"]], "InlineFormula", ExpressionUUID->
  "94f4e38b-5df3-48b2-9fcc-40c8355a8d84"],
 " and the top and bottom cap."
}], "MathCaption",
 CellID->336594815, ExpressionUUID->"2b2db0c8-a67b-40ee-b7a4-f2023aab50aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gr", "=", 
  RowBox[{"Graphics3D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"EdgeForm", "[", "]"}], ",", 
      RowBox[{"Polygon", "[", "top", "]"}], ",", 
      RowBox[{"Polygon", "[", "bottom", "]"}], ",", "bss"}], "}"}], ",", 
    RowBox[{"Boxed", "\[Rule]", "False"}]}], "]"}]}]], "Input",
 CellLabel->"In[633]:=",
 CellID->1112702624, ExpressionUUID->"b2793233-2119-4ab0-a45b-090540f18f1d"],

Cell[BoxData[
