Cell[BoxData[
 RowBox[{
  RowBox[{"shape", "=", 
   RowBox[{"OpenCascadeShapeIntersection", "[", 
    RowBox[{"s1", ",", "s2"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[554]:=",
 CellID->1102921381, ExpressionUUID->"de1449f3-b1d9-476a-ac2e-14e0cd6efd50"]
}, Open  ]],

