Cell["\<\
The geometry includes two iron regions: one in the horseshoe magnet and the \
other in the coin. The actual magnet region is located at the tip of the \
horseshoe magnet, and the surrounding domain consists of air.\
\>", "Text",
 CellID->125832649,ExpressionUUID->"022393c4-9df1-4502-bc3c-ea312f642b1a"],

Cell["\<\
One thing to keep in mind is the scale used in the geometric model. If the \
length of the boundary mesh is, for example, in units of meters, then the \
material parameters will need to be specified in consistent units. In this \
specific case, the units of the boundary mesh are in meters.\
\>", "Text",
 CellID->73109095,ExpressionUUID->"655cd089-e8a0-4d81-b72f-f0b157269617"],

Cell[CellGroupData[{

Cell["Mesh Generation", "Subsection",
 CellID->1342392676,ExpressionUUID->"788ce52c-688b-424c-9693-b534cdaa644f"],

Cell["\<\
To perform a finite element analysis, the boundary mesh representation of the \
geometric model needs to be discretized into a mesh. In this same process, \
different material regions are specified with element markers.\
\>", "Text",
 CellID->122527172,ExpressionUUID->"277b3c7a-e0d0-4637-a8bd-5d2c11aa0444"],

Cell[CellGroupData[{

Cell["Specify region markers:", "MathCaption",
 CellID->285201430,ExpressionUUID->"18cbfb89-501d-4cf0-a89d-7d8973e90ea4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"regionMarker", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<IronCoin\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Iron\>\"", "->", "2"}], ",", 
     RowBox[{"\"\<Magnet\>\"", "->", "3"}], ",", 
     RowBox[{"\"\<Air\>\"", "->", "4"}]}], "|>"}]}], ";"}]], "Input",
 CellLabel->"In[40]:=",
 CellID->39834786,ExpressionUUID->"1c2e0bda-e34f-41a8-bad5-74628cc72766"]
}, Open  ]],

Cell["\<\
Each material region integer marker is related to an arbitrary coordinate in \
that region.\
\>", "Text",
 CellID->536422034,ExpressionUUID->"a40a2081-5346-49a6-a0a9-caeb04922a0e"],

Cell[CellGroupData[{

Cell["Generate the mesh:", "MathCaption",
 CellID->204619372,ExpressionUUID->"37241aba-ed40-4b8f-a629-5256c3c5a1c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mesh", "=", 
  RowBox[{"ToElementMesh", "[", 
   RowBox[{"bmesh", ",", 
    RowBox[{"\"\<RegionMarker\>\"", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.03"}], ",", "0.005", ",", "0.003"}], "}"}], ",", 
         RowBox[{"regionMarker", "[", "\"\<IronCoin\>\"", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.06", ",", "0.03", ",", "0.005"}], "}"}], ",", 
         RowBox[{"regionMarker", "[", "\"\<Iron\>\"", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0.02", ",", "0.03", ",", "0.005"}], "}"}], ",", 
         RowBox[{"regionMarker", "[", "\"\<Magnet\>\"", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0.05", ",", "0.05"}], "}"}], ",", 
         RowBox[{"regionMarker", "[", "\"\<Air\>\"", "]"}]}], "}"}]}], 
      "}"}]}]}], "]"}]}]], "Input",
 CellLabel->"In[41]:=",
 CellID->14800895,ExpressionUUID->"d814b1d0-9988-4f4a-8390-b0c55a429235"],

Cell[BoxData[
 TagBox[
  RowBox[{"ElementMesh", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.05`"}], ",", "0.11999999999999998`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", "0.1`"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.`", ",", "0.06`"}], "}"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"TetrahedronElement", "[", 
      RowBox[{
       StyleBox["\<\"<\"\>",
        ShowStringCharacters->False], "\[InvisibleSpace]", "28640", "\[InvisibleSpace]", 
       StyleBox["\<\">\"\>",
        ShowStringCharacters->False]}], "]"}], "}"}]}], "]"}],
  False,
  Editable->False,
  SelectWithContents->True]], "Output",
 CellChangeTimes->{3.9441860060648727`*^9, 3.944188770446129*^9, 
  3.944203293025881*^9, 3.994200307591364*^9},
 CellLabel->"Out[41]=",
 CellID->241288145,ExpressionUUID->"28aef6e9-cd66-466f-bda8-8dc5d47d9199"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visualize the parts specified by the markers:", "MathCaption",
 CellID->293585150,ExpressionUUID->"822794ee-3c88-4ca7-b730-03a13696414a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"parts", "=", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"mesh", "[", 
      RowBox[{"\"\<Wireframe\>\"", "[", 
       RowBox[{
        RowBox[{"ElementMarker", "\[Equal]", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<MeshElement\>\"", "\[Rule]", "\"\<MeshElements\>\""}], ",", 
        RowBox[{"\"\<ElementMeshDirective\>\"", "\[Rule]", 
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{"EdgeForm", "[", "]"}], ",", 
           RowBox[{"FaceForm", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}]}], "]"}], "]"}],
      "&"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "Gray"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "Gray"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"3", ",", "Red"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "LightBlue"}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[42]:=",
 CellID->1064950847,ExpressionUUID->"465e172b-4fb5-4f4e-85c5-4b4875a879a1"],

