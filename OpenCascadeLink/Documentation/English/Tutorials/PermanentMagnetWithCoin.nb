Cell[CellGroupData[{

Cell["Permanent Magnet with Coin", "Title",
 CellChangeTimes->{{3.944202245859315*^9, 3.944202252991879*^9}},
 CellID->509267359,ExpressionUUID->"71de4b94-a90a-44f5-bb05-62eda0f86549"],

Cell[TextData[{
 "In this example a permanent magnet with a coin in front is to be created. \
Since this is geometry is symmetric in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[InvisibleSpace]", "y"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"13c3ef63-6dfc-460c-af7d-20666166f011"],
 " and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[InvisibleSpace]", "z"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"192ce08a-935f-468f-bf74-fd9c85c63614"],
 " plane, only 1/4 of the geometry is created. The magnet itself is composed \
of two regions, one which has a magnetization and the second part that is \
made of iron."
}], "Text",
 CellChangeTimes->{{3.944187794302424*^9, 3.944188009889885*^9}, {
  3.944202265675733*^9, 3.944202290269294*^9}, {3.944202637809111*^9, 
  3.9442026406913958`*^9}},
 CellID->1123884489,ExpressionUUID->"b7a19a98-d706-42c8-867c-f5c0ff60d0f5"],

Cell[CellGroupData[{

Cell[TextData[{
 "Load the ",
 StyleBox["OpenCascade",
  FontSlant->"Italic"],
 " and finite element packages:"
}], "MathCaption",
 CellChangeTimes->{{3.9441805722586308`*^9, 3.94418058765245*^9}, {
  3.944202813380604*^9, 3.944202820920239*^9}},
 CellID->836781195,ExpressionUUID->"d1733039-c673-4a7d-a675-640e5acc4624"],

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<OpenCascadeLink`\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Needs", "[", "\"\<NDSolve`FEM`\>\"", "]"}]}], "Input",
 CellChangeTimes->{
  3.944180583102996*^9, {3.944202808289007*^9, 3.944202808757897*^9}},
 CellLabel->"In[1]:=",
 CellID->2058623809,ExpressionUUID->"c18eca97-6ef2-41ec-b22c-1eb6750be7b2"]
}, Open  ]],

Cell[TextData[{
 "First, a face of the magnet is created in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[InvisibleSpace]", "z"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"2f4a06c6-0e79-42c4-a58a-2f7377d28b68"],
 " plane and then swept along a curve to obtain a solid component of the \
entire magnet region."
}], "Text",
 CellChangeTimes->{{3.9441808694472*^9, 3.944180921447789*^9}, {
   3.9441810024901323`*^9, 3.9441811071316767`*^9}, {3.944181139489912*^9, 
   3.9441811594732113`*^9}, {3.944183569573724*^9, 3.944183581404086*^9}, 
   3.944188034049045*^9, {3.9441881011326513`*^9, 3.944188102395093*^9}, {
   3.944202309439252*^9, 3.9442023105962877`*^9}, 3.944202564182963*^9},
 CellID->330021218,ExpressionUUID->"f084631c-60c5-48bd-b00e-7036521b1b37"],

