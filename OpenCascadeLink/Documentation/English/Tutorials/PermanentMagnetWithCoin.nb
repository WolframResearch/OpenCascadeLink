Cell[CellGroupData[{

Cell["Extract the faces of all shapes:", "MathCaption",
 CellChangeTimes->{{3.9441842760779057`*^9, 3.944184283824957*^9}, 
   3.9442027853099213`*^9},
 CellID->1349979877,ExpressionUUID->"9efa025f-4c64-4475-a781-c7f771050b04"],

Cell[BoxData[
 RowBox[{
  RowBox[{"faces", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"OpenCascadeShapeFaces", "/@", 
       RowBox[{"{", 
        RowBox[{"magnetShape", ",", "coinShape", ",", "airShape"}], "}"}]}], ",",
       "divisionFace"}], "}"}], "]"}]}], ";"}]], "Input",
