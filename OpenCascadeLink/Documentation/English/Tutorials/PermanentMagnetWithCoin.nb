Cell[TextData[{
 "The geometric model contains a 1/4 geometry of a horseshoe permanent \
magnet, a coin in front of it and a bounding box. The reduction to the 1/4 \
geometry is possible due to the symmetries that the geometry has. One plane \
of symmetry is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "0"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "1c926482-f4ad-4586-85f0-df915edb7137"],
 " plane and the second plane of symmetry is the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", "0"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "fa29d15b-43c5-46f7-a430-220099ccfafc"],
 " plane. For the actual computation, only the 1/4 geometry will be used, but \
it is possible to visualize the full geometry."
}], "Text",
 CellChangeTimes->{{3.9442032542357903`*^9, 3.9442032547181664`*^9}},
 CellID->476444600,ExpressionUUID->"9effb8f5-d77e-4107-b08f-807932c2128c"],

Cell[CellGroupData[{

Cell["\<\
Create the three remaining 1/4 geometries to create the complete geometry:\
\>", "MathCaption",
 CellID->1451978402,ExpressionUUID->"7b7991d2-667e-4412-8ee4-84e509d78af4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bmesh2", "=", 
   RowBox[{"ElementMeshProjection", "[", 
    RowBox[{"bmesh", ",", 
     RowBox[{"ReflectionTransform", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0"}], "}"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bmesh3", "=", 
   RowBox[{"ElementMeshProjection", "[", 
    RowBox[{"bmesh", ",", 
     RowBox[{"ReflectionTransform", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bmesh4", "=", 
   RowBox[{"ElementMeshProjection", "[", 
    RowBox[{"bmesh3", ",", 
     RowBox[{"ReflectionTransform", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0"}], "}"}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[36]:=",
 CellID->793519074,ExpressionUUID->"81a47e78-3f1e-4de5-9705-5333c31e308b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visualize the complete geometry:", "MathCaption",
 CellID->1187193742,ExpressionUUID->"8b0e29e7-6830-4956-a7cd-f2cde66450d8"],

Cell[CellGroupData[{

